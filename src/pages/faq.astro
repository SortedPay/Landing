---
import Base from '@/layouts/Base.astro';

const title = 'FAQ — Sorted';
const description = 'Honest answers to the questions people actually ask about Sorted. Money, safety, fees, the card, what happens if we go under.';

const groups = [
  {
    title: 'The basics',
    items: [
      {
        q: 'What is Sorted, in one sentence?',
        a: 'An Australian peer-to-peer payments app that\'s free and instant. Sign in with your phone, send to any @handle, lands in seconds. The Sorted card lets you tap to pay with your balance anywhere Mastercard works.',
      },
      {
        q: 'Wait, is this crypto?',
        a: 'The rails are, technically. But you\'ll never see a wallet address, a seed phrase or a gas fee. You sign in with your phone number, type a handle, money moves. The blockchain is plumbing, the same way you don\'t think about TCP/IP when you send a text.',
      },
      {
        q: 'How do I sign up?',
        a: 'No app store needed. Sorted runs from your browser and adds to your home screen like any app. Enter your number, claim a handle, verify your ID (driver\'s licence or passport plus a selfie), top up via PayID, send. About two minutes end to end.',
      },
      {
        q: 'Is it actually free? Where\'s the catch?',
        a: 'Not from your pocket. We earn on card transactions, optional extras like instant cash-outs, and partnerships with the businesses in Sorted Perks. Sending money to mates is free and stays free. No transaction fees, no FX margin on Aussie sends.',
      },
    ],
  },
  {
    title: 'Money & safety',
    items: [
      {
        q: 'What happens if Sorted goes under?',
        a: 'Your balance isn\'t on Sorted\'s books. It\'s AUDD, issued by AUDC Pty Ltd and backed 1:1 by Australian dollars in tier-1 Australian bank accounts. If we vanished tomorrow your AUDD is still yours and still redeemable through the issuer. We\'re the front door, not the vault.',
      },
      {
        q: 'Are deposits insured (FCS / government guarantee)?',
        a: 'Sorted is not an Authorised Deposit-taking Institution, so the Financial Claims Scheme doesn\'t cover a Sorted balance directly. The AUD reserves backing AUDD are held in tier-1 ADI accounts, which are themselves FCS-protected at the issuer level. We\'re upfront about this: if FCS coverage matters to you, weigh it up.',
      },
      {
        q: 'Is there really a card?',
        a: 'Yes. The Sorted card, on the Mastercard network. Tap your phone or the physical card anywhere Mastercard is accepted, straight from your balance. Freeze and unfreeze it from the app in one tap. It rolls out with launch; claim your handle to be first in line.',
      },
      {
        q: 'Will my balance ever earn anything?',
        a: 'Not right now, and we won\'t pretend otherwise. Down the track we\'re exploring ways to make idle balances do more, subject to the right regulatory settings. Today the deal is simple: free sends to mates, the Sorted card, and Sorted Points for doing normal stuff.',
      },
      {
        q: 'What if I get scammed or send to the wrong person?',
        a: 'Slide-to-send shows the recipient\'s name and avatar before you commit. Unclaimed sends to a phone number can be pulled back for 24 hours. Past that, instant settlement means we can\'t reverse a send on our own, same as PayID, but we\'ll do everything we can to help recover funds.',
      },
    ],
  },
  {
    title: 'The fine print',
    items: [
      {
        q: 'Who regulates you?',
        a: 'Sorted operates as an authorised representative under an Australian Financial Services Licence. AUDD is issued by AUDC Pty Ltd, which holds its own AFSL, granted by ASIC in February 2026. Our AML/CTF program is built to AUSTRAC\'s standards as part of the launch track.',
      },
      {
        q: 'Can I send money overseas?',
        a: 'Not yet. We\'re nailing Australian P2P and the Sorted card first. International sends are next on the list; claim a handle to be first to hear.',
      },
      {
        q: 'What are Sorted Points?',
        a: 'Doing normal stuff earns points: sending to mates, tapping your card, referring a friend. Points unlock perks at local Aussie businesses. They\'re tied to what you do, never to how much you hold. No purchase-this, no maintain-that.',
      },
      {
        q: 'Who\'s behind this?',
        a: 'A small team in Brisbane who got tired of money taking three days to move between people who already know each other. Get in touch via the contact page if you want a more thorough answer.',
      },
    ],
  },
];
---

<Base title={title} description={description} active="faq">
<section class="subhero dotgrid">
  <div class="container">
    <div class="crumbs"><a href="/">Sorted</a><span class="sep"></span><span>FAQ</span></div>
    <span class="subhero-eyebrow">Sorted · FAQ</span>
    <h1>Fair <span class="hl hl-coral">questions.</span></h1>
    <p class="subhero-sub">No legalese. No "industry-leading". The questions people actually ask, answered the way we'd answer them to our mates.</p>
  </div>
</section>
<section class="section reveal"><div class="container">
    <div class="faq-page">
      {groups.map((group) => (
        <div class="faq-group">
          <h2 class="faq-group-title">{group.title}</h2>
          <div class="faq-list faq-list--flush">
            {group.items.map((item) => (
              <details class="faq-item">
                <summary class="faq-q">{item.q}<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
                <div class="faq-a">{item.a}</div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div></div></section>
<section class="page-cta">
  <div class="container">
    <div class="page-cta-inner reveal">
      <h2 class="page-cta-title">Got more questions?</h2>
      <p class="page-cta-sub">Hit us up at <strong>hello@paymentsorted.com</strong>. We read everything.</p>
      <div class="page-cta-actions">
        <a data-claim href="#" class="btn btn-dark btn-lg">Claim your handle <svg class="icon"><use href="#i-arrow-right"/></svg></a>
        <a href="/contact" class="btn btn-secondary btn-lg">Contact us</a>
      </div>
    </div>
  </div>
</section>
</Base>

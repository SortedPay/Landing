    transform: skewX(-4deg) rotate(-1.5deg);
    border-radius: 12px;
  }
  .hero-sub {
    font-size: 21px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 520px;
    margin-bottom: 44px;
    font-weight: 450;
    animation: fadeUp 800ms var(--ease-smooth) 180ms both;
  }
  .hero-sub strong { color: var(--ink); font-weight: 700; }
  .hero-actions {
    display: flex;
    gap: 12px;
    margin-bottom: 64px;
    flex-wrap: wrap;
    animation: fadeUp 800ms var(--ease-smooth) 280ms both;
  }
  .hero-trust {
    display: flex;
    gap: 28px;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 28px;

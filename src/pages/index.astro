  .trust-num .unit { font-size: 18px; color: var(--ink-muted); font-weight: 500; }
  .trust-label {
    font-size: 13px;
    color: var(--ink-muted);
    font-weight: 500;
    margin-top: 4px;
  }

  /* Phone mockup */
  .hero-visual {
    position: relative;
    z-index: 1;
    animation: fadeUp 1000ms var(--ease-smooth) 320ms both;
  }
  .phone {
    background: var(--ink);
    border-radius: 44px;
    padding: 12px;
    width: 360px;
    margin: 0 auto;
    box-shadow:
      0 1px 0 rgba(255,255,255,0.05) inset,
      0 30px 60px -20px rgba(14, 14, 24, 0.4),
      0 50px 100px -40px rgba(14, 14, 24, 0.3);
    position: relative;
    z-index: 2;
    transform: rotate(-2deg);
    animation: phone-float 6s ease-in-out infinite;
  }
  @keyframes phone-float {
    0%, 100% { transform: rotate(-2deg) translateY(0); }
    50% { transform: rotate(-2deg) translateY(-12px); }
  }
  .phone-screen {
    background: var(--paper);
    border-radius: 32px;
    height: 660px;
    overflow: hidden;
    position: relative;
  }
  .phone-notch {
    position: absolute;

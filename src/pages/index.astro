  /* Anyone section — SMS flow showcase */
  .anyone-section {
    padding: 120px 0;
    background: var(--paper);
    position: relative;
    overflow: hidden;
  }
  .anyone-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(14,14,24,0.04) 1px, transparent 1.5px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .anyone-section .section-head { position: relative; z-index: 1; }
  .anyone-section .section-title .hl.hl-butter { color: var(--ink); }

  .anyone-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 64px;
    position: relative;
    z-index: 1;
  }
  .anyone-card {
    background: var(--paper-elevated);
    border: 2px solid var(--ink);
    border-radius: 24px;
    padding: 28px;
    box-shadow: 0 6px 0 var(--ink);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.2s ease;
  }
  .anyone-card:hover { transform: translateY(-4px); box-shadow: 0 10px 0 var(--ink); }
  .anyone-card--sky { background: var(--sky-soft); }
  .anyone-card--lime { background: var(--lime-soft); }

  .anyone-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .anyone-title {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }
  .anyone-desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Mini phone mockup (step 1) */
  .phone-mini {
    margin-top: 8px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 18px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: inset 0 0 0 1px rgba(14,14,24,0.04);
  }
  .phone-mini-head {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    padding-bottom: 8px;
    border-bottom: 1px dashed rgba(14,14,24,0.15);
  }
  .phone-mini-recipient {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 4px 0;
  }
  .phone-mini-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--lime-soft);
    border: 2px dashed var(--lime-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }
  .phone-mini-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
  }
  .phone-mini-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
  }
  .phone-mini-amount {
    font-family: var(--font-numeric, var(--font-mono));
    font-weight: 700;
    font-size: 36px;
    color: var(--ink);
    text-align: center;
    letter-spacing: -0.03em;
  }
  .phone-mini-amount span { font-size: 44px; }
  .phone-mini-btn {
    background: var(--lime);
    border: 2px solid var(--ink);
    border-radius: 12px;
    padding: 10px 14px;
    text-align: center;
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
    box-shadow: 0 3px 0 var(--ink);

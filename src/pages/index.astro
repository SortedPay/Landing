  .trust-item { display: flex; flex-direction: column; gap: 2px; }
  .trust-num {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
    font-variant-numeric: tabular-nums;

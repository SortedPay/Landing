  /* SMS mockup (step 2) */
  .sms-mockup {
    margin-top: 8px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 18px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sms-mockup-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sms-mockup-from { color: var(--ink); font-weight: 700; }
  .sms-mockup-bubble {
    background: var(--paper-deep);
    border-radius: 14px 14px 14px 4px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
  }
  .sms-mockup-bubble strong { color: var(--ink); font-weight: 700; }
  .sms-mockup-link {
    color: var(--sky);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
  }
  .sms-mockup-foot {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: right;
  }

  /* Claim mockup (step 3) */
  .claim-mockup {
    margin-top: 8px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 18px;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .claim-mockup-num {
    font-family: var(--font-numeric, var(--font-mono));
    font-weight: 700;
    font-size: 44px;
    color: var(--ink);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .claim-mockup-num .dim { color: var(--ink-muted); font-size: 28px; }
  .claim-mockup-from {
    font-size: 14px;
    color: var(--ink-soft);
  }
  .claim-mockup-from strong { color: var(--ink); font-weight: 700; }
  .claim-mockup-btn {
    background: var(--lime);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 8px 16px;
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
    box-shadow: 0 3px 0 var(--ink);
    margin-top: 4px;
  }
  .claim-mockup-foot {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Peace of mind callout */
  .anyone-callout {
    margin: 56px auto 0;
    max-width: 720px;
    background: var(--sky-soft, #D6ECFF);
    border: 2px solid var(--ink);
    border-radius: 20px;
    padding: 20px 24px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    box-shadow: 0 4px 0 var(--ink);
    position: relative;
    z-index: 1;
  }
  .anyone-callout-icon {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    color: var(--ink);
  }
  .anyone-callout-icon svg { width: 100%; height: 100%; }
  .anyone-callout-body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .anyone-callout-body strong { color: var(--ink); font-weight: 700; }

  /* Earn section */
  .earn-section {
    padding: 120px 0;
    position: relative;
    overflow: hidden;
  }
  .earn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .earn-card {
    background: var(--lime);
    color: var(--ink);
    border-radius: 32px;
    padding: 44px 40px;
    border: 3px solid var(--ink);
    box-shadow: 0 12px 0 var(--ink);
    position: relative;
    transform: rotate(-1.5deg);
    transition: transform 400ms var(--ease-spring);
    text-align: left;
  }
  .earn-card:hover { transform: rotate(0); }

  /* Massive rate number — the star of the show */
  .earn-card-rate {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 24px;
    line-height: 0.85;
  }
  .earn-card-rate-num {
    font-family: var(--font-display);
    font-size: clamp(96px, 14vw, 180px);
    font-weight: 700;
    letter-spacing: -0.06em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    line-height: 0.85;
  }
  .earn-card-rate-unit {
    font-size: 0.5em;
    margin-left: 4px;
  }
  .earn-card-rate-pa {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.65;
    align-self: flex-end;
    padding-bottom: 18px;
  }

  .earn-card-divider {
    height: 2.5px;
    background: var(--ink);
    margin: 0 0 22px;
    border-radius: 2px;
  }

  /* Legacy rows (unused) */
  .earn-card-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }
  .earn-card-row {
    display: grid;
    grid-template-columns: 70px 24px 1fr;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: rgba(14, 14, 24, 0.04);
    border-radius: 12px;
    border: 1.5px solid rgba(14, 14, 24, 0.1);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }
  .earn-card-row--feature {
    background: var(--ink);
    color: var(--lime);
    border-color: var(--ink);
  }
  .earn-card-row-amt {
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .earn-card-row-arrow {
    font-size: 18px;
    opacity: 0.45;
    text-align: center;
  }
  .earn-card-row--feature .earn-card-row-arrow { opacity: 0.5; }
  .earn-card-row-yield {
    font-size: 22px;
    letter-spacing: -0.02em;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .earn-card-row-yield .dim {
    font-size: 0.72em;
    opacity: 0.55;
    font-weight: 600;
  }

  .earn-card-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    opacity: 0.7;
  }
  .earn-card-foot .live {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ink);
    animation: pulse 1.4s ease-in-out infinite;
  }

  .earn-copy h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.035em;
    margin-bottom: 24px;
  }
  .earn-copy p {
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-bottom: 20px;
    max-width: 520px;
  }
  .earn-bullets { list-style: none; margin-top: 28px; }
  .earn-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1.5px dashed var(--line);
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .earn-bullets li:last-child { border-bottom: none; }
  .earn-bullets .check {
    flex-shrink: 0;
    width: 28px; height: 28px;
    background: var(--lime);
    border: 2px solid var(--ink);
    border-radius: 8px;
    display: grid; place-items: center;
    box-shadow: 0 2px 0 var(--ink);
    transform: rotate(-3deg);
  }
  .earn-bullets li:nth-child(2) .check { background: var(--coral); transform: rotate(2deg); }
  .earn-bullets li:nth-child(3) .check { background: var(--sky); transform: rotate(-2deg); }
  .earn-bullets .check svg { width: 14px; height: 14px; stroke: var(--ink); stroke-width: 3; }
  .earn-bullets strong { color: var(--ink); font-weight: 700; }

  /* Statement section */
  .statement-section {
    padding: 140px 0;
    text-align: center;
    background: var(--paper-deep);
    position: relative;
  }
  .statement-block { max-width: 1000px; margin: 0 auto; }
  .big-quote {
    font-family: var(--font-display);
    font-size: clamp(56px, 8vw, 116px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }
  .big-quote .word {
    display: inline-block;
    padding: 0 20px;
    border: 3px solid var(--ink);
    border-radius: 14px;
    box-shadow: 0 6px 0 var(--ink);
    color: var(--ink);
  }
  .big-quote .w-lime { background: var(--lime); transform: rotate(-1.5deg); }
  .big-quote .w-coral { background: var(--coral); color: var(--paper); transform: rotate(1.5deg); }
  .big-quote .w-sky { background: var(--sky); transform: rotate(-1deg); }

  .statement-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--ink);
    border: 2.5px solid var(--ink);
    border-radius: 24px;
    overflow: hidden;
    max-width: 880px;
    margin: 60px auto 0;
    box-shadow: 0 6px 0 var(--ink);
  }
  .ss-cell {
    background: var(--paper-elevated);
    padding: 36px 24px;
    text-align: center;
  }
  .ss-num {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 6px;
    font-variant-numeric: tabular-nums;
  }
  .ss-num .unit { color: var(--ink-muted); font-size: 26px; }
  .ss-label { font-size: 14px; color: var(--ink-muted); font-weight: 500; line-height: 1.3; }

  /* Trust section */
  .trust-section { padding: 120px 0; }
  .trust-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .trust-section-copy h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.035em;
    margin-bottom: 24px;
  }
  .trust-section-copy p {
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-bottom: 16px;
    max-width: 540px;
  }
  .trust-card {
    background: var(--paper-elevated);
    border: 2.5px solid var(--ink);
    border-radius: 28px;
    padding: 36px;
    box-shadow: 0 8px 0 var(--ink);
    transform: rotate(1deg);
    transition: transform 350ms var(--ease-spring);
  }
  .trust-card:hover { transform: rotate(0); }
  .trust-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1.5px dashed var(--line);
  }
  .trust-row:first-child { padding-top: 0; }
  .trust-row:last-child { padding-bottom: 0; border-bottom: none; }
  .trust-row-icon {
    flex-shrink: 0;
    width: 44px; height: 44px;
    border-radius: 12px;
    border: 2px solid var(--ink);
    display: grid; place-items: center;
    box-shadow: 0 2px 0 var(--ink);
    color: var(--ink);
  }
  .trust-row-icon svg { width: 20px; height: 20px; stroke-width: 2; }
  .trust-row:nth-child(1) .trust-row-icon { background: var(--lime); }
  .trust-row:nth-child(2) .trust-row-icon { background: var(--sky); }
  .trust-row:nth-child(3) .trust-row-icon { background: var(--coral); color: var(--paper); }
  .trust-row:nth-child(4) .trust-row-icon { background: var(--butter); }
  .trust-row-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 4px;
  }
  .trust-row-desc { font-size: 14px; color: var(--ink-muted); line-height: 1.45; }
  .audd-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: var(--lime);
    font-weight: 700;
    transition: text-decoration-color 200ms ease;
  }
  .audd-link:hover { text-decoration-color: var(--ink); }

  /* FAQ */
  .faq-section {
    padding: 120px 0;
    background: var(--paper-deep);
  }
  .faq-list {
    max-width: 820px;
    margin: 60px auto 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .faq-item {
    background: var(--paper-elevated);
    border: 2px solid var(--ink);
    border-radius: 18px;
    box-shadow: 0 3px 0 var(--ink);
    overflow: hidden;
    transition: box-shadow 200ms var(--ease-spring), transform 200ms var(--ease-spring);
  }
  .faq-item[open] { box-shadow: 0 5px 0 var(--ink); transform: translateY(-1px); }
  .faq-q {
    list-style: none;
    cursor: pointer;
    padding: 22px 26px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--ink);
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-chevron {
    width: 32px; height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--lime);
    border: 1.5px solid var(--ink);
    display: grid; place-items: center;
    transition: transform 250ms var(--ease-spring);
    color: var(--ink);
  }
  .faq-chevron svg { width: 14px; height: 14px; stroke-width: 2.5; }
  .faq-item[open] .faq-chevron { transform: rotate(180deg); background: var(--coral); color: var(--paper); }
  .faq-a {
    padding: 0 26px 24px 26px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .faq-a strong { color: var(--ink); font-weight: 700; }
  .faq-a a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--lime); text-decoration-thickness: 2px; text-underline-offset: 3px; font-weight: 600; }

  /* CTA stage container — see global.css for sticker positioning */
  .cta-stage {
    position: relative;
    isolation: isolate;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; gap: 60px; }
    .phone { transform: rotate(-1deg); }
    .earn-grid, .trust-grid { grid-template-columns: 1fr; gap: 40px; }
    .earn-card { transform: rotate(-1deg); }
    .trust-card { transform: rotate(0); }
    .anyone-grid { gap: 20px; }
  }
  @media (max-width: 720px) {
    .hero { padding: 32px 0 40px; }
    .hero-actions .btn { flex: 1; min-width: 0; }
    .usp-stack { grid-template-columns: 1fr; }
    .usp-card.featured { grid-column: span 1; }
    .usp-vs { grid-template-columns: 1fr 1fr; gap: 14px 20px; }
    .how-grid { grid-template-columns: 1fr; }
    .anyone-grid { grid-template-columns: 1fr; gap: 20px; margin-top: 40px; }
    .anyone-section { padding: 60px 0; }
    .anyone-callout { margin-top: 32px; flex-direction: column; gap: 12px; }
    .statement-stats { grid-template-columns: 1fr; }
    .why-us, .how-section, .earn-section, .trust-section, .faq-section, .statement-section { padding: 60px 0; }
    .phone { width: 88vw; max-width: 360px; }
    .float-card-1 { right: -10px; top: 30px; }
    .float-card-2 { left: -10px; bottom: 60px; }
    .earn-card { padding: 32px 24px; }
    .trust-card { padding: 28px; }
    .earn-card-rate { gap: 8px; }
    .earn-card-rate-pa { padding-bottom: 12px; }
  }
  @media (max-width: 420px) {
    /* Tighter buttons + stacked layout for small phones */
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn { width: 100%; }
    .btn-lg { padding: 14px 20px; font-size: 15px; }
    /* Smaller phone mockup */
    .phone { width: 100%; max-width: 340px; }
    /* Hero trust strip — 3 columns squished, switch to stacked rows */
    .hero-trust { gap: 18px; }
    .trust-num { font-size: 28px; }
    /* Earn card rate scales down */
    .earn-card-rate-num { font-size: 88px; }
    /* USP cards: tighter padding */
    .usp-card { padding: 24px; }
  }

  /* ========== Sorted+ teaser section ========== */
  .plus-tease {
    padding: 80px 0;
    background: var(--paper);
  }
  .plus-card {
    max-width: 760px;
    margin: 0 auto;
    background: var(--ink);
    color: var(--paper);
    border: 2.5px solid var(--ink);
    border-radius: 28px;
    padding: 48px 44px;
    text-align: center;
    box-shadow: 0 8px 0 var(--ink);
    position: relative;
    overflow: hidden;
  }
  .plus-card-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: var(--butter);
    color: var(--ink);
    padding: 4px 12px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    margin-bottom: 22px;
  }
  .plus-card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 18px;
  }
  .plus-card-title .hl-butter {
    background: var(--butter);
    color: var(--ink);
    padding: 0 8px;
    border-radius: 6px;
  }
  .plus-card-sub {
    font-size: 17px;
    line-height: 1.55;
    max-width: 600px;
    margin: 0 auto 16px;
    color: var(--paper);
    opacity: 0.92;
  }
  .plus-card-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--paper);
    opacity: 0.6;
    margin: 0;
  }
  @media (max-width: 640px) {
    .plus-tease { padding: 56px 0; }
    .plus-card { padding: 36px 24px; border-radius: 22px; }
    .plus-card-sub { font-size: 15px; }
  }

  /* ========== Sorted card mockup v2 — cropped wordmark ========== */
  .scard {
    container-type: inline-size;
    background: var(--ink);
    border: 2.5px solid var(--ink);
    border-radius: 18px;
    aspect-ratio: 1.586;
    padding: 0 7cqw 7cqw;
    display: flex;
    flex-direction: column;
    color: var(--paper);
    box-shadow: 0 6px 0 rgba(14, 14, 24, 0.18);
    position: relative;
    overflow: hidden;
    background-image: radial-gradient(circle, rgba(200, 241, 84, 0.10) 1px, transparent 1px);
    background-size: 18px 18px;
  }
  .scard > * { position: relative; z-index: 1; }
  .scard-word {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 50%;
    transform: translate(-50%, -46%);
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: "opsz" 30;
    font-size: 26.5cqw;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--lime);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
  }
  .scard-handle { margin-top: auto; margin-bottom: 3cqw; font-family: var(--font-mono); font-size: 6.6cqw; letter-spacing: 0.08em; opacity: 0.94; }
  .scard-bottom { display: flex; justify-content: space-between; align-items: center; }
  .scard-tap { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 3.2cqw; text-transform: uppercase; letter-spacing: 0.14em; opacity: 0.8; }
  .scard-tap .icon { width: 4cqw; height: 4cqw; stroke: var(--lime); fill: none; }
  .scard-mc { display: inline-flex; }
  .scard-mc i { width: 7.5cqw; height: 7.5cqw; border-radius: 50%; display: block; }
  .scard-mc i:first-child { background: var(--coral); opacity: 0.92; }
  .scard-mc i:last-child { background: var(--butter); opacity: 0.92; margin-left: -3cqw; }
  .scard-meta { margin-top: 16px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); text-align: center; }

  /* ========== Nan-section unified interior shots ========== */
  .nan-shot {
    margin-top: auto;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 16px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .nan-shot--ink { background: var(--ink); }
  .nan-shot-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .nan-shot-label {
    font-family: var(--font-mono); font-size: 10px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    background: var(--ink); color: var(--paper);
    border-radius: 999px; padding: 4px 10px;
  }
  .nan-shot-label--lime { background: var(--lime); color: var(--ink); }
  .nan-shot-value { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--ink-muted); }
  .nan-shot-value--paper { color: rgba(246, 242, 233, 0.65); }
  .nan-shot-amount { font-family: var(--font-display); font-weight: 700; font-size: 40px; letter-spacing: -0.04em; line-height: 1; color: var(--ink); }
  .nan-shot-amount--paper { color: var(--paper); }

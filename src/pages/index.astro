  }
  .ph-greet-block { display: flex; flex-direction: column; }
  .ph-handle {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }
  .ph-greeting {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .ph-bell {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--paper-elevated);
    border: 2px solid var(--ink);
    display: grid; place-items: center;
    position: relative;
  }
  .ph-bell svg { width: 16px; height: 16px; }
  .ph-bell::after {
    content: '';
    position: absolute;
    top: 4px; right: 4px;
    width: 8px; height: 8px;
    background: var(--coral);
    border: 1.5px solid var(--ink);
    border-radius: 50%;
  }
  .ph-balance {
    margin: 4px 16px 14px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 22px;
    padding: 22px 20px 20px;
    position: relative;
    overflow: hidden;
    border: 2px solid var(--ink);
  }
  .ph-balance-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: rgba(246,242,233,0.55);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 6px;
    position: relative;
  }
  .ph-balance-amt {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
    margin-bottom: 14px;
    position: relative;
    font-variant-numeric: tabular-nums;
  }
  .ph-balance-amt .cents { font-size: 26px; color: rgba(246,242,233,0.6); }
  .ph-balance-amt .ccy {
    font-size: 14px;
    color: rgba(246,242,233,0.5);
    font-family: var(--font-mono);
    font-weight: 600;
    margin-left: 6px;
    letter-spacing: 0.05em;
  }
  .ph-earn-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--lime);
    color: var(--ink);
    padding: 5px 11px 5px 9px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-mono);
    border: 1.5px solid var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ph-earn-pill .live-tick {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--ink);
    animation: pulse 1.2s ease-in-out infinite;
  }
  .ph-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 0 16px;
    margin-bottom: 16px;
  }
  .ph-action {
    background: var(--paper-elevated);
    border: 2px solid var(--ink);
    border-radius: 16px;
    padding: 14px 8px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    box-shadow: 0 2px 0 var(--ink);
  }
  .ph-action-icon {
    width: 40px; height: 40px;
    border-radius: 12px;
    display: grid; place-items: center;
    border: 1.5px solid var(--ink);
  }
  .ph-action-icon svg { width: 18px; height: 18px; stroke-width: 2; }
  .ph-action-icon.send { background: var(--lime); }
  .ph-action-icon.receive { background: var(--sky); }
  .ph-action-icon.topup { background: var(--coral); color: var(--paper); }
  .ph-action-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .ph-section-label {
    padding: 0 22px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
    margin-top: 4px;
  }
  .ph-activity-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px;
  }
  /* FLAT STICKER AVATARS — no gradients */
  .ph-act-avatar {
    width: 34px; height: 34px;
    border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
    border: 1.5px solid var(--ink);
    flex-shrink: 0;
  }
  .ph-act-avatar.a1 { background: var(--coral); color: var(--paper); }
  .ph-act-avatar.a2 { background: var(--lime); color: var(--ink); }
  .ph-act-avatar.a3 { background: var(--sky); color: var(--ink); }
  .ph-act-info { flex: 1; min-width: 0; }
  .ph-act-name { font-size: 13px; font-weight: 700; color: var(--ink); line-height: 1.2; }
  .ph-act-meta { font-size: 11px; color: var(--ink-muted); margin-top: 1px; font-family: var(--font-mono); }
  .ph-act-amt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .ph-act-amt.in { color: var(--lime-deep); }
  .ph-act-amt.out { color: var(--ink); }

  .float-card {
    position: absolute;
    background: var(--paper-elevated);
    border: 2px solid var(--ink);
    border-radius: 14px;
    padding: 12px 14px;
    box-shadow: 0 4px 0 var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 5;
  }
  .float-card-1 { top: 60px; right: -10px; transform: rotate(4deg); animation: drift1 5s ease-in-out infinite; }
  .float-card-2 { bottom: 90px; left: -20px; transform: rotate(-4deg); animation: drift2 7s ease-in-out infinite; }
  @keyframes drift1 { 0%, 100% { transform: rotate(4deg) translateY(0); } 50% { transform: rotate(4deg) translateY(-10px); } }
  @keyframes drift2 { 0%, 100% { transform: rotate(-4deg) translateY(0); } 50% { transform: rotate(-4deg) translateY(-12px); } }
  .float-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    display: grid; place-items: center;
    border: 1.5px solid var(--ink);
  }
  .float-icon.lime { background: var(--lime); color: var(--ink); }
  .float-icon.coral { background: var(--coral); color: var(--ink); }
  .float-icon svg { width: 16px; height: 16px; stroke-width: 2.2; }
  .float-text { font-size: 13px; font-weight: 700; line-height: 1.2; font-family: var(--font-display); letter-spacing: -0.01em; }
  .float-sub { font-size: 11px; color: var(--ink-muted); font-weight: 500; margin-top: 2px; font-family: var(--font-mono); }

  /* USP grid */
  .why-us {
    padding: 120px 0 140px;
  }
  .usp-stack {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 1080px;
    margin: 0 auto;
  }
  .usp-card {
    background: var(--paper-elevated);
    border: 2.5px solid var(--ink);
    border-radius: 24px;
    padding: 36px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 6px 0 var(--ink);
    transition: all 280ms var(--ease-spring);
  }
  .usp-card:hover {
    transform: translate(-2px, -4px);
    box-shadow: 0 10px 0 var(--ink);
  }
  .usp-card.featured {
    background: var(--ink);
    color: var(--paper);
    grid-column: span 2;
  }
  .usp-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    background: var(--lime);
    color: var(--ink);
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1.5px solid var(--ink);
  }
  .usp-tag .icon { width: 13px; height: 13px; stroke-width: 2.4; }
  .usp-headline {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.025em;
    margin-bottom: 16px;
  }
  .usp-card.featured .usp-headline { font-size: clamp(32px, 4vw, 56px); }
  .usp-card.featured .usp-headline .stress { color: var(--lime); }
  .usp-card:not(.featured) .usp-headline .stress {
    color: var(--ink);
    position: relative;
  }
  .usp-card:not(.featured) .usp-headline .stress::after {
    content: '';
    position: absolute;
    left: -4%; right: -4%;
    bottom: 4%;
    height: 30%;
    background: var(--lime);
    z-index: -1;
    transform: skewX(-6deg);
    border-radius: 4px;
  }
  .usp-body {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-bottom: 0;
  }
  .usp-card.featured .usp-body { color: rgba(246,242,233,0.75); font-size: 18px; }
  .usp-vs {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 2px dashed var(--line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    font-size: 13px;
  }
  .usp-card.featured .usp-vs { border-color: rgba(246,242,233,0.18); }
  .usp-vs > div { display: flex; flex-direction: column; gap: 4px; }
  .usp-vs-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .usp-card.featured .usp-vs-label { color: rgba(246,242,233,0.5); }
  .usp-vs-val {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .usp-vs-val.them { color: var(--ink-muted); text-decoration: line-through; text-decoration-thickness: 2px; }
  .usp-card.featured .usp-vs-val.them { color: rgba(246,242,233,0.4); }
  .usp-vs-val.us { color: var(--ink); }
  .usp-card.featured .usp-vs-val.us { color: var(--lime); }

  /* How section (dark) */
  .how-section {
    padding: 120px 0 140px;
    background: var(--ink);
    color: var(--paper);
    position: relative;
    overflow: hidden;
  }
  .how-section .section-eyebrow {
    background: var(--lime);
    color: var(--ink);
    border-color: var(--lime);
    box-shadow: 0 2px 0 rgba(255,255,255,0.1);
  }
  .how-section .section-title { color: var(--paper); }
  .how-section .section-title .hl::before { background: var(--lime); }
  .how-section .section-title .hl { color: var(--ink); }
  .how-section .section-sub { color: rgba(246,242,233,0.7); }
  .how-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 26px 26px;
    pointer-events: none;
  }
  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 60px;
    position: relative;
  }
  .how-step {
    background: rgba(255,255,255,0.03);
    border: 2px solid rgba(255,255,255,0.1);

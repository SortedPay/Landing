---
import Base from '@/layouts/Base.astro';
import Marquee from '@/components/Marquee.astro';
import PageCTA from '@/components/PageCTA.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import StickerMark from '@/components/StickerMark.astro';
import P2PAnimation from '@/components/P2PAnimation.astro';

const title = 'Sorted — Money, sorted. Free, instant payments for Aussies.';
const description = 'Send to any @handle in seconds, then tap to pay everywhere else with the Sorted card. The peer-to-peer payments app built for everyday Aussies.';

const faqs = [
  {
    q: 'How fast is "instant"?',
    a: 'Under two seconds, tap to balance. Not "next business day". Saturday night, Boxing Day, 3am on a Tuesday. Same speed.',
  },
  {
    q: 'Do I need a wallet or anything crypto-y?',
    a: 'Nope. Sign in with your phone, pick a @handle, you\'re in. The settlement layer is plumbing. We do the boring bits.',
  },
  {
    q: 'How is it free? Where\'s the catch?',
    a: 'Not from your pocket. We earn on card transactions, optional extras like instant cash-outs, and Sorted Perks partnerships. Sending to mates is free and stays free.',
  },
  {
    q: 'Where\'s my money actually kept?',
    a: 'In tier-1 Australian bank accounts, backed 1:1 by AUDD, the Australian-dollar stablecoin issued by AUDC Pty Ltd under an AFSL. Redeemable for real AUD any time.',
  },
  {
    q: 'Will my balance ever earn anything?',
    a: 'Not right now, and we won\'t pretend otherwise. Today the deal is free sends, the Sorted card, and Sorted Points for doing normal stuff.',
  },
];

const perks = ['Cafés', 'Pubs', 'Bakeries', 'Grocers', 'Barbers', 'Bookshops'];
---

<Base title={title} description={description}>

<!-- ───────────── HERO ───────────── -->
<section class="hero dotgrid dotgrid-hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="hero-badge"><svg class="hero-badge-mark" aria-hidden="true"><use href="#sorted-mark"/></svg> Beta · Made in Brisbane</span>
      <h1 class="hero-title">Money,<br><span class="hl">sorted.</span></h1>
      <p class="hero-sub">Send to any <strong>@handle</strong> in seconds. Tap to pay everywhere else.<br><strong>Free. Instant. Sorted.</strong></p>
      <div class="hero-actions">
        <a data-claim href="#" class="btn btn-primary btn-lg">Claim your handle <svg class="icon"><use href="#i-arrow-right"/></svg></a>
        <a href="/how-it-works" class="btn btn-secondary btn-lg">How it works</a>
      </div>
      <div class="hero-trust">
        <div class="trust-item">
          <div class="trust-num"><span data-count="0" data-prefix="$">$0</span></div>
          <div class="trust-label">Fees. Ever.</div>
        </div>
        <div class="trust-item">
          <div class="trust-num"><span data-count="2" data-prefix="<">&lt;2</span><span class="unit">sec</span></div>
          <div class="trust-label">Tap to balance</div>
        </div>
        <div class="trust-item">
          <div class="trust-num">24/7</div>
          <div class="trust-label">Even Christmas morning</div>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-parallax">
        <div class="hero-tilt" data-tilt="7">
          <div class="phone">
            <div class="phone-notch"></div>
            <div class="phone-screen">
              <div class="phone-status"><span>9:41</span><span>● ● ●</span></div>
              <div class="phone-header">
                <div class="ph-greet-block">
                  <span class="ph-handle">@hannah</span>
                  <span class="ph-greeting">G'day, Hannah</span>
                </div>
                <div class="ph-bell"><svg class="icon"><use href="#i-bell"/></svg></div>
              </div>
              <div class="ph-balance">
                <div class="ph-balance-label">Available balance</div>
                <div class="ph-balance-amt">$1,247<span class="cents">.50</span><span class="ccy">AUD</span></div>
                <div class="ph-earn-pill"><span class="live-tick"></span> +12 Sorted Points</div>
              </div>
              <div class="ph-actions">
                <div class="ph-action"><div class="ph-action-icon send"><svg class="icon"><use href="#i-send"/></svg></div><span class="ph-action-label">Send</span></div>
                <div class="ph-action"><div class="ph-action-icon receive"><svg class="icon"><use href="#i-receive"/></svg></div><span class="ph-action-label">Receive</span></div>
                <div class="ph-action"><div class="ph-action-icon topup"><svg class="icon"><use href="#i-plus"/></svg></div><span class="ph-action-label">Top up</span></div>
              </div>
              <div class="ph-section-label">Recent</div>
              <div class="ph-activity-row">
                <div class="ph-act-avatar a1">MT</div>
                <div class="ph-act-info"><div class="ph-act-name">Maya Thompson</div><div class="ph-act-meta">@maya · 2 min ago</div></div>
                <div class="ph-act-amt out">−$24.00</div>
              </div>
              <div class="ph-activity-row">
                <div class="ph-act-avatar a2">JL</div>
                <div class="ph-act-info"><div class="ph-act-name">Jack Lawson</div><div class="ph-act-meta">@jackl · 18 min ago</div></div>
                <div class="ph-act-amt in">+$85.00</div>
              </div>
              <div class="ph-activity-row">
                <div class="ph-act-avatar a3">CC</div>
                <div class="ph-act-info"><div class="ph-act-name">Corner Cafe</div><div class="ph-act-meta">Card tap · 9:41 am</div></div>
                <div class="ph-act-amt out">−$5.50</div>
              </div>
            </div>
          </div>
        </div>
        <div class="float-card float-card-1">
          <div class="float-icon lime"><svg class="icon"><use href="#i-zap"/></svg></div>
          <div><div class="float-text">$50 sent</div><div class="float-sub">Settled in 1.8s</div></div>
        </div>
        <div class="float-card float-card-2">
          <div class="float-icon coral"><svg class="icon"><use href="#i-spark"/></svg></div>
          <div><div class="float-text">+24 Sorted Points</div><div class="float-sub">Earned this week</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<Marquee bgAbove="var(--paper)" bgBelow="var(--paper)" ribbon="var(--lime)" ink="var(--ink)"
  phrases={['FREE FOREVER', 'INSTANT', 'NO BSB', 'NO FEES', 'NO DRAMA', 'BUILT IN AUSTRALIA']} />

<!-- ───────────── WHY ───────────── -->
<section class="why-us" id="why">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="section-title">Built for everyday <span class="hl">Aussies.</span></h2>
      <p class="section-sub">Shouting Maccas. Paying your mate back. Sending Mum a hundred for her birthday. None of it should cost a cent.</p>
    </div>

    <P2PAnimation />

    <div class="usp-stack slap-stagger">
      <article class="usp-card">
        <span class="usp-sticker usp-sticker--lime">01</span>
        <h3 class="usp-headline">No BSBs. <span class="stress">No drama.</span></h3>
        <p class="usp-body">Every account has a <strong>@handle</strong>. Type it, slide to send, it lands before you've put your phone down. No wallets, no seed phrases, no gas fees.</p>
      </article>
      <article class="usp-card">
        <span class="usp-sticker usp-sticker--sky">02</span>
        <h3 class="usp-headline">Real dollars. <span class="stress">Real banks.</span></h3>
        <p class="usp-body">Backed 1:1 by AUDD, held in tier-1 Australian banks. Not offshore. Not a coin you have to think about. Just dollars.</p>
      </article>
      <article class="usp-card">
        <span class="usp-sticker usp-sticker--butter">03</span>
        <h3 class="usp-headline">Normal stuff <span class="stress">earns points.</span></h3>
        <p class="usp-body">Sending mates, tapping your card. All of it stacks <strong>Sorted Points</strong>, and points unlock perks at the locals. <a href="#locals" class="audd-link">Meet the locals →</a></p>
      </article>
    </div>
  </div>
</section>

<!-- ───────────── HOW ───────────── -->
<section class="how-section" id="how">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="section-title">Easy as. <span class="hl">Three taps.</span></h2>
      <p class="section-sub">A $5 coffee debt or rent with three flatmates. Same flow, same speed, same zero fees.</p>
    </div>
    <div class="how-grid slap-stagger">
      <div class="how-step">
        <div class="how-icon"><svg class="icon"><use href="#i-plus"/></svg></div>
        <div class="how-num">01</div>
        <h3 class="how-title">Top up free</h3>
        <p class="how-desc">Link your bank once. PayID in, lands in seconds. No card surcharge, no "loading fee".</p>
      </div>
      <div class="how-step">
        <div class="how-icon"><svg class="icon"><use href="#i-at"/></svg></div>
        <div class="how-num">02</div>
        <h3 class="how-title">Send to @anyone</h3>
        <p class="how-desc">Type a handle, slide to send. Under two seconds, any hour of any day.</p>
      </div>
      <div class="how-step">
        <div class="how-icon"><svg class="icon"><use href="#i-card"/></svg></div>
        <div class="how-num">03</div>
        <h3 class="how-title">Tap to pay</h3>
        <p class="how-desc">The Sorted card turns your balance into everyday money. Anywhere Mastercard works.</p>
      </div>
    </div>
  </div>
</section>

<SectionDivider bgAbove="var(--ink)" bgBelow="var(--paper)" ribbon="var(--butter)" ink="var(--ink)" label="SEND TO ANYONE · EVEN YOUR NAN" />

<!-- ───────────── ANYONE (SMS) ───────────── -->
<section class="anyone-section" id="anyone">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-eyebrow">No app required</span>
      <h2 class="section-title">Send to <span class="hl hl-butter">anyone.</span><br>Even your nan.</h2>
      <p class="section-sub">No handle? No worries. <strong>Type their number. We do the rest.</strong></p>
    </div>

    <div class="anyone-grid slap-stagger">
      <div class="anyone-card">
        <span class="anyone-tag">01 · You</span>
        <h3 class="anyone-title">Type their number.<br>Tap send.</h3>
        <p class="anyone-desc">Three taps and you're done.</p>
        <div class="nan-shot">
          <div class="nan-shot-row"><span class="nan-shot-label">To</span><span class="nan-shot-value">Mum · 0412 345 678</span></div>
          <div class="nan-shot-amount">$100<span class="dim">.00</span></div>
          <div class="nan-shot-btn nan-shot-btn--ink">Hold to send →</div>
        </div>
      </div>
      <div class="anyone-card anyone-card--sky">
        <span class="anyone-tag">02 · They get a text</span>
        <h3 class="anyone-title">A text does the<br>heavy lifting.</h3>
        <p class="anyone-desc">From a real Aussie number. Reads like a mate sent it.</p>
        <div class="nan-shot">
          <div class="nan-shot-row"><span class="nan-shot-label">SMS</span><span class="nan-shot-value">From Sorted · now</span></div>
          <div class="nan-bubble"><strong>Hannah sent you $100.</strong> Tap to&nbsp;claim&nbsp;→<br><span class="nan-bubble-link">sorted.au/c/9F2X</span></div>
        </div>
      </div>
      <div class="anyone-card anyone-card--lime">
        <span class="anyone-tag">03 · They claim</span>
        <h3 class="anyone-title">60 seconds<br>and it's theirs.</h3>
        <p class="anyone-desc">Tap, pick a handle, money's in their balance.</p>
        <div class="nan-shot nan-shot--ink">
          <div class="nan-shot-row"><span class="nan-shot-label nan-shot-label--lime">Claim</span><span class="nan-shot-value nan-shot-value--paper">from @hannah</span></div>
          <div class="nan-shot-amount nan-shot-amount--paper">$100<span class="dim">.00</span></div>
          <div class="nan-shot-btn nan-shot-btn--lime">Claim in Sorted →</div>
        </div>
      </div>
    </div>

    <div class="anyone-callout reveal">
      <div class="anyone-callout-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
      <div class="anyone-callout-body"><strong>Changed your mind?</strong> Undo for 24 hours while it's unclaimed. We remind both of you after 12.</div>
    </div>
  </div>
</section>

<SectionDivider bgAbove="var(--paper)" bgBelow="var(--paper)" ribbon="var(--coral)" ink="var(--ink)" label="SEND · TAP · SORTED · FREE P2P · MADE IN AUS" />

<!-- ───────────── CARD + PERKS ───────────── -->
<section class="card-section dotgrid" id="card">
  <div class="container">
    <div class="card-grid">
      <div class="card-copy reveal">
        <h2>Tap to pay, <span class="hl">everywhere.</span></h2>
        <p>Your balance isn't stuck in an app. The Sorted card spends it at the cafe, the servo, online. Anywhere Mastercard works.</p>
        <ul class="card-bullets">
          <li><span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg></span><span><strong>Tap your phone or the card.</strong> In store, online, here or overseas.</span></li>
          <li><span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg></span><span><strong>Freeze it in one tap.</strong> Unfreeze just as fast.</span></li>
          <li><span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg></span><span><strong>Every tap earns Sorted Points.</strong> One point per dollar.</span></li>
        </ul>
      </div>
      <div class="card-stage">
        <div class="scard-wrap" data-tilt="10">
          <div class="scard">
            <span class="scard-word" aria-hidden="true">sorted.</span>
            <div class="scard-handle">@hannah</div>
            <div class="scard-bottom">
              <span class="scard-tap"><svg class="icon"><use href="#i-zap"/></svg> Tap to pay</span>
              <span class="scard-mc"><i></i><i></i></span>
            </div>
          </div>
        </div>
        <div class="scard-meta reveal"><span class="live"></span> Rolling out with launch. Claim your handle to be first.</div>
      </div>
    </div>

    <div class="perks-strip reveal" id="locals">
      <div class="perks-lead">
        <span class="section-eyebrow">Sorted Perks</span>
        <p class="perks-text">Points unlock perks at the locals. <strong>Every perk puts a customer through a local door.</strong></p>
      </div>
      <div class="perks-chips slap-stagger">
        {perks.map((p) => <span class="perk-chip">{p}<em>soon</em></span>)}
      </div>
      <p class="perks-note">Run a local? <a class="audd-link" href="/contact">Say g'day →</a></p>
    </div>
  </div>
</section>

<!-- ───────────── STATEMENT ───────────── -->
<section class="statement-section">
  <div class="container">
    <h2 class="big-quote" aria-label="Fast. Free. Sorted.">
      <span class="word w-lime" style="--tilt:-2deg">FAST.</span>
      <span class="word w-coral" style="--tilt:1.5deg">FREE.</span>
      <span class="word w-sky" style="--tilt:-1deg">SORTED.</span>
    </h2>
    <p class="section-sub reveal">No fees. No BSBs. No three-day waits. Just send.</p>
  </div>
</section>

<!-- ───────────── TRUST ───────────── -->
<section class="trust-section">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-copy reveal">
        <h2>Fair dinkum <span class="hl hl-sky">AUD.</span></h2>
        <p>Every dollar is backed 1:1 by AUDD, the Australian-dollar stablecoin issued by AUDC Pty Ltd under an Australian Financial Services Licence, with reserves in <strong>tier-1 Aussie banks</strong>.</p>
        <p>Solana is just the rails. Fast, cheap, invisible. You'll never see it.</p>
        <p><a href="https://audd.digital" target="_blank" rel="noopener" class="audd-link">More about AUDD →</a></p>
      </div>
      <div class="trust-card slap">
        <div class="trust-row"><div class="trust-row-icon"><svg class="icon"><use href="#i-shield"/></svg></div><div><div class="trust-row-title">AFSL-regulated</div><div class="trust-row-desc">AUDD is issued under an Australian Financial Services Licence.</div></div></div>
        <div class="trust-row"><div class="trust-row-icon"><svg class="icon"><use href="#i-lock"/></svg></div><div><div class="trust-row-title">1:1 backed</div><div class="trust-row-desc">Every dollar is a real Australian dollar, redeemable any time.</div></div></div>
        <div class="trust-row"><div class="trust-row-icon"><svg class="icon"><use href="#i-globe"/></svg></div><div><div class="trust-row-title">Reserves at home</div><div class="trust-row-desc">Tier-1 Aussie banks, not offshore.</div></div></div>
        <div class="trust-row"><div class="trust-row-icon"><svg class="icon"><use href="#i-zap"/></svg></div><div><div class="trust-row-title">Solana rails</div><div class="trust-row-desc">Sub-second settlement. Network cost covered by us.</div></div></div>
      </div>
    </div>
  </div>
</section>

<SectionDivider bgAbove="var(--paper)" bgBelow="var(--paper-deep)" ribbon="var(--sky)" ink="var(--ink)" label="GOT QUESTIONS · WE'VE GOT ANSWERS" />

<!-- ───────────── FAQ ───────────── -->
<section class="faq-section" id="faq">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="section-title">Got <span class="hl hl-coral">questions?</span></h2>
      <p class="section-sub">No legalese. No fine print. Just the good oil.</p>
    </div>
    <div class="faq-list slap-stagger">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary class="faq-q">{f.q}<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
          <div class="faq-a">{f.a}</div>
        </details>
      ))}
    </div>
    <p class="faq-more reveal"><a class="audd-link" href="/faq">All the questions →</a></p>
  </div>
</section>

<Marquee bgAbove="var(--paper-deep)" bgBelow="var(--paper)" ribbon="var(--lime)" ink="var(--ink)"
  phrases={['SEND THAT CASH MATE', "DW BRO IT'S SORTED", 'EASY MONEY', 'SWEET AS', 'TOO EASY', 'ALL GOOD']} />

<div class="cta-stage">
  <StickerMark color="var(--coral)" size="160px" rotate={-12} class="cta-sticker cta-sticker--left" />
  <StickerMark color="var(--lime)" size="180px" rotate={14} class="cta-sticker cta-sticker--right" />
  <PageCTA
    title="Right then.<br>Claim your <span class='hl'>@handle.</span>"
    sub="Ninety seconds. No card. No catch."
    primaryLabel="Claim your handle"
    secondaryLabel="How it works"
    secondaryHref="/how-it-works"
  />
</div>

</Base>

<style>
  /* ========== HERO ========== */
  .hero { padding: 72px 0 110px; position: relative; overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--paper-elevated);
    border: 2px solid var(--ink);
    border-radius: 100px;
    padding: 7px 14px 7px 9px;
    box-shadow: 0 2px 0 var(--ink);
    transform: rotate(-1.5deg);
    margin-bottom: 26px;
    animation: fadeUp 700ms var(--ease-smooth) both;
    transition: transform 300ms var(--ease-spring);
  }
  .hero-badge:hover { transform: rotate(1deg) scale(1.03); }
  .hero-badge-mark { width: 20px; height: 20px; }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(56px, 13vw, 168px);
    line-height: 0.88;
    letter-spacing: -0.05em;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 32px;
    animation: fadeUp 800ms var(--ease-smooth) 80ms both;
  }
  .hero-title .hl { padding: 0 12px; }
  .hero-title .hl::before { inset: 6% -2% 6% -2%; transform: skewX(-4deg) rotate(-1.5deg); border-radius: 12px; }
  .hero-sub {
    font-size: 21px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 520px;
    margin-bottom: 40px;
    font-weight: 450;
    animation: fadeUp 800ms var(--ease-smooth) 180ms both;
  }
  .hero-sub strong { color: var(--ink); font-weight: 700; }
  .hero-actions {
    display: flex; gap: 12px; margin-bottom: 56px; flex-wrap: wrap;
    animation: fadeUp 800ms var(--ease-smooth) 280ms both;
  }
  .hero-trust {
    display: flex; gap: 28px; align-items: center; flex-wrap: wrap;
    padding-top: 28px;
    border-top: 2px dashed var(--line);
    animation: fadeUp 800ms var(--ease-smooth) 380ms both;
  }
  .trust-item { display: flex; flex-direction: column; gap: 2px; }
  .trust-num {
    font-family: var(--font-display);
    font-size: 32px; font-weight: 700; letter-spacing: -0.03em;
    color: var(--ink); line-height: 1; font-variant-numeric: tabular-nums;
  }
  .trust-num .unit { font-size: 18px; color: var(--ink-muted); font-weight: 500; }
  .trust-label { font-size: 13px; color: var(--ink-muted); font-weight: 500; margin-top: 4px; }

  /* Phone */
  .hero-visual { position: relative; z-index: 1; animation: fadeUp 1000ms var(--ease-smooth) 320ms both; }
  .hero-parallax { position: relative; }
  .hero-tilt { transform-style: preserve-3d; }
  .phone {
    background: var(--ink);
    border-radius: 44px;
    padding: 12px;
    width: 360px;
    margin: 0 auto;
    box-shadow: 0 1px 0 rgba(255,255,255,0.05) inset, 0 30px 60px -20px rgba(14,14,24,0.4), 0 50px 100px -40px rgba(14,14,24,0.3);
    position: relative; z-index: 2;
    transform: rotate(-2deg);
    animation: phone-float 6s ease-in-out infinite;
  }
  @keyframes phone-float {
    0%, 100% { transform: rotate(-2deg) translateY(0); }
    50% { transform: rotate(-2deg) translateY(-12px); }
  }
  .phone-screen { background: var(--paper); border-radius: 32px; height: 640px; overflow: hidden; position: relative; }
  .phone-notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 100px; height: 28px; background: var(--ink); border-radius: 100px; z-index: 10; }
  .phone-status { padding: 16px 22px 8px; display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; color: var(--ink); font-family: var(--font-mono); }
  .phone-header { padding: 8px 22px 14px; display: flex; justify-content: space-between; align-items: center; }
  .ph-greet-block { display: flex; flex-direction: column; }
  .ph-handle { font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--ink-muted); letter-spacing: 0.04em; margin-bottom: 2px; }
  .ph-greeting { font-family: var(--font-display); font-size: 19px; font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .ph-bell { width: 36px; height: 36px; border-radius: 50%; background: var(--paper-elevated); border: 2px solid var(--ink); display: grid; place-items: center; position: relative; }
  .ph-bell svg { width: 16px; height: 16px; }
  .ph-bell::after { content: ''; position: absolute; top: 4px; right: 4px; width: 8px; height: 8px; background: var(--coral); border: 1.5px solid var(--ink); border-radius: 50%; }
  .ph-balance { margin: 4px 16px 14px; background: var(--ink); color: var(--paper); border-radius: 22px; padding: 22px 20px 20px; position: relative; overflow: hidden; border: 2px solid var(--ink); }
  .ph-balance-label { font-family: var(--font-mono); font-size: 10px; font-weight: 600; color: rgba(246,242,233,0.55); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 6px; }
  .ph-balance-amt { font-family: var(--font-display); font-size: 44px; font-weight: 700; letter-spacing: -0.035em; line-height: 1; margin-bottom: 14px; font-variant-numeric: tabular-nums; }
  .ph-balance-amt .cents { font-size: 26px; color: rgba(246,242,233,0.6); }
  .ph-balance-amt .ccy { font-size: 14px; color: rgba(246,242,233,0.5); font-family: var(--font-mono); font-weight: 600; margin-left: 6px; letter-spacing: 0.05em; }
  .ph-earn-pill { display: inline-flex; align-items: center; gap: 6px; background: var(--lime); color: var(--ink); padding: 5px 11px 5px 9px; border-radius: 100px; font-size: 11px; font-weight: 700; font-family: var(--font-mono); border: 1.5px solid var(--ink); text-transform: uppercase; letter-spacing: 0.04em; }
  .ph-earn-pill .live-tick { width: 6px; height: 6px; border-radius: 50%; background: var(--ink); animation: pulse 1.2s ease-in-out infinite; }
  .ph-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 0 16px; margin-bottom: 16px; }
  .ph-action { background: var(--paper-elevated); border: 2px solid var(--ink); border-radius: 16px; padding: 14px 8px 12px; display: flex; flex-direction: column; align-items: center; gap: 8px; box-shadow: 0 2px 0 var(--ink); }
  .ph-action-icon { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; border: 1.5px solid var(--ink); }
  .ph-action-icon svg { width: 18px; height: 18px; stroke-width: 2; }
  .ph-action-icon.send { background: var(--lime); }
  .ph-action-icon.receive { background: var(--sky); }
  .ph-action-icon.topup { background: var(--coral); color: var(--paper); }
  .ph-action-label { font-size: 12px; font-weight: 700; color: var(--ink); letter-spacing: -0.01em; }
  .ph-section-label { padding: 0 22px; font-family: var(--font-mono); font-size: 10px; font-weight: 600; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.1em; margin: 4px 0 8px; }
  .ph-activity-row { display: flex; align-items: center; gap: 12px; padding: 10px 22px; }
  .ph-act-avatar { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; font-size: 13px; color: var(--ink); border: 1.5px solid var(--ink); flex-shrink: 0; }
  .ph-act-avatar.a1 { background: var(--coral); color: var(--paper); }
  .ph-act-avatar.a2 { background: var(--lime); }
  .ph-act-avatar.a3 { background: var(--sky); }
  .ph-act-info { flex: 1; min-width: 0; }
  .ph-act-name { font-size: 13px; font-weight: 700; color: var(--ink); line-height: 1.2; }
  .ph-act-meta { font-size: 11px; color: var(--ink-muted); margin-top: 1px; font-family: var(--font-mono); }
  .ph-act-amt { font-family: var(--font-display); font-weight: 700; font-size: 15px; letter-spacing: -0.02em; flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .ph-act-amt.in { color: var(--lime-deep); }
  .ph-act-amt.out { color: var(--ink); }

  .float-card {
    position: absolute;
    background: var(--paper-elevated);
    border: 2px solid var(--ink);
    border-radius: 14px;
    padding: 12px 14px;
    box-shadow: 0 4px 0 var(--ink);
    display: flex; align-items: center; gap: 10px;
    z-index: 5;
  }
  .float-card-1 { top: 60px; right: -10px; animation: drift1 5s ease-in-out infinite; }
  .float-card-2 { bottom: 90px; left: -20px; animation: drift2 7s ease-in-out infinite; }
  @keyframes drift1 { 0%, 100% { transform: rotate(4deg) translateY(0); } 50% { transform: rotate(4deg) translateY(-10px); } }
  @keyframes drift2 { 0%, 100% { transform: rotate(-4deg) translateY(0); } 50% { transform: rotate(-4deg) translateY(-12px); } }
  .float-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; border: 1.5px solid var(--ink); }
  .float-icon.lime { background: var(--lime); color: var(--ink); }
  .float-icon.coral { background: var(--coral); color: var(--ink); }
  .float-icon svg { width: 16px; height: 16px; stroke-width: 2.2; }
  .float-text { font-size: 13px; font-weight: 700; line-height: 1.2; font-family: var(--font-display); letter-spacing: -0.01em; }
  .float-sub { font-size: 11px; color: var(--ink-muted); font-weight: 500; margin-top: 2px; font-family: var(--font-mono); }

  /* ========== WHY ========== */
  .why-us { padding: 110px 0 120px; }
  .usp-stack { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1120px; margin: 0 auto; }
  .usp-card {
    background: var(--paper-elevated);
    border: 2.5px solid var(--ink);
    border-radius: 24px;
    padding: 36px 30px 30px;
    position: relative;
    box-shadow: 0 6px 0 var(--ink);
    transition: transform 280ms var(--ease-spring), box-shadow 280ms var(--ease-spring);
  }
  .usp-card:hover { transform: translate(-2px, -4px) rotate(-0.4deg); box-shadow: 0 10px 0 var(--ink); }
  .usp-sticker {
    position: absolute; top: -14px; left: 24px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: 0.14em;
    padding: 5px 12px; border-radius: 999px;
    border: 2px solid var(--ink); box-shadow: 0 2px 0 var(--ink);
    transform: rotate(-4deg);
    transition: transform 250ms var(--ease-spring);
  }
  .usp-card:hover .usp-sticker { transform: rotate(3deg) scale(1.06); }
  .usp-sticker--lime { background: var(--lime); }
  .usp-sticker--sky { background: var(--sky); }
  .usp-sticker--butter { background: var(--butter); }
  .usp-headline {
    font-family: var(--font-display);
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 700; line-height: 1.02; letter-spacing: -0.025em;
    margin-bottom: 14px;
  }
  .usp-headline .stress { position: relative; display: inline-block; }
  .usp-headline .stress::after {
    content: ''; position: absolute; left: -4%; right: -4%; bottom: 4%; height: 30%;
    background: var(--lime); z-index: -1; transform: skewX(-6deg); border-radius: 4px;
  }
  .usp-body { font-size: 15.5px; line-height: 1.55; color: var(--ink-soft); }

  /* ========== HOW (dark) ========== */
  .how-section { padding: 110px 0 130px; background: var(--ink); color: var(--paper); position: relative; overflow: hidden; }
  .how-section::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 26px 26px; pointer-events: none;
  }
  .how-section .section-title { color: var(--paper); }
  .how-section .section-title .hl { color: var(--ink); }
  .how-section .section-sub { color: rgba(246,242,233,0.7); }
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 56px; position: relative; }
  .how-step {
    background: rgba(255,255,255,0.03);
    border: 2px solid rgba(255,255,255,0.1);
    border-radius: 24px; padding: 32px; position: relative;
    transition: transform 280ms var(--ease-spring), border-color 200ms ease, background 200ms ease;
  }
  .how-step:hover { border-color: var(--lime); background: rgba(200,241,84,0.06); transform: translateY(-4px) rotate(-0.3deg); }
  .how-num { font-family: var(--font-display); font-size: 80px; font-weight: 700; line-height: 0.85; color: var(--lime); margin-bottom: 16px; letter-spacing: -0.04em; }
  .how-icon { position: absolute; top: 32px; right: 32px; width: 44px; height: 44px; border-radius: 12px; background: rgba(200,241,84,0.1); border: 1.5px solid rgba(200,241,84,0.3); display: grid; place-items: center; color: var(--lime); }
  .how-icon svg { width: 20px; height: 20px; stroke-width: 2; }
  .how-title { font-family: var(--font-display); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 10px; }
  .how-desc { font-size: 15.5px; line-height: 1.55; color: rgba(246,242,233,0.7); }

  /* ========== ANYONE ========== */
  .anyone-section { padding: 110px 0; background: var(--paper); position: relative; overflow: hidden; }
  .anyone-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(14,14,24,0.04) 1px, transparent 1.5px); background-size: 22px 22px; pointer-events: none; }
  .anyone-section .section-head { position: relative; z-index: 1; }
  .anyone-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 56px; position: relative; z-index: 1; }
  .anyone-card {
    background: var(--paper-elevated); border: 2px solid var(--ink); border-radius: 24px; padding: 28px;
    box-shadow: 0 6px 0 var(--ink); display: flex; flex-direction: column; gap: 12px;
    transition: transform 250ms var(--ease-spring), box-shadow 250ms var(--ease-spring);
  }
  .anyone-card:hover { transform: translateY(-4px) rotate(0.4deg); box-shadow: 0 10px 0 var(--ink); }
  .anyone-card--sky { background: var(--sky-soft); }
  .anyone-card--lime { background: var(--lime-soft); }
  .anyone-tag { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; color: var(--ink-muted); text-transform: uppercase; }
  .anyone-title { font-family: var(--font-display); font-size: 26px; line-height: 1.05; letter-spacing: -0.02em; color: var(--ink); margin: 0; }
  .anyone-desc { font-size: 15px; line-height: 1.5; color: var(--ink-soft); margin: 0; }
  .nan-shot { margin-top: auto; background: var(--paper); border: 1.5px solid var(--ink); border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  .nan-shot--ink { background: var(--ink); }
  .nan-shot-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .nan-shot-label { font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; background: var(--ink); color: var(--paper); border-radius: 999px; padding: 4px 10px; }
  .nan-shot-label--lime { background: var(--lime); color: var(--ink); }
  .nan-shot-value { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--ink-muted); }
  .nan-shot-value--paper { color: rgba(246,242,233,0.65); }
  .nan-shot-amount { font-family: var(--font-display); font-weight: 700; font-size: 40px; letter-spacing: -0.04em; line-height: 1; color: var(--ink); }
  .nan-shot-amount--paper { color: var(--paper); }
  .nan-shot-amount .dim { opacity: 0.45; font-size: 24px; }
  .nan-shot-btn { font-family: var(--font-display); font-weight: 700; font-size: 14px; letter-spacing: -0.01em; text-align: center; border-radius: 12px; padding: 11px 14px; }
  .nan-shot-btn--ink { background: var(--ink); color: var(--paper); }
  .nan-shot-btn--lime { background: var(--lime); color: var(--ink); border: 1.5px solid rgba(14,14,24,0.35); }
  .nan-bubble { background: var(--sky-soft); border: 1.5px solid var(--ink); border-radius: 16px 16px 16px 4px; padding: 14px 16px; font-size: 14.5px; line-height: 1.5; color: var(--ink); }
  .nan-bubble-link { font-family: var(--font-mono); font-size: 12px; text-decoration: underline; display: inline-block; margin-top: 4px; }
  .anyone-callout {
    margin: 48px auto 0; max-width: 680px;
    background: var(--sky-soft); border: 2px solid var(--ink); border-radius: 20px; padding: 18px 22px;
    display: flex; align-items: flex-start; gap: 16px; box-shadow: 0 4px 0 var(--ink); position: relative; z-index: 1;
  }
  .anyone-callout-icon { flex: 0 0 30px; width: 30px; height: 30px; color: var(--ink); }
  .anyone-callout-icon svg { width: 100%; height: 100%; }
  .anyone-callout-body { font-size: 15px; line-height: 1.55; color: var(--ink-soft); }
  .anyone-callout-body strong { color: var(--ink); font-weight: 700; }

  /* ========== CARD + PERKS ========== */
  .card-section { padding: 110px 0 100px; position: relative; overflow: hidden; }
  .card-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .card-copy h2 { font-family: var(--font-display); font-size: clamp(40px, 5vw, 64px); font-weight: 700; line-height: 0.96; letter-spacing: -0.035em; margin-bottom: 22px; }
  .card-copy p { font-size: 18px; line-height: 1.55; color: var(--ink-soft); margin-bottom: 18px; max-width: 520px; }
  .card-bullets { list-style: none; margin-top: 24px; }
  .card-bullets li { display: flex; align-items: flex-start; gap: 14px; padding: 12px 0; border-bottom: 1.5px dashed var(--line); font-size: 16px; line-height: 1.45; color: var(--ink-soft); }
  .card-bullets li:last-child { border-bottom: none; }
  .card-bullets .check { flex-shrink: 0; width: 28px; height: 28px; background: var(--lime); border: 2px solid var(--ink); border-radius: 8px; display: grid; place-items: center; box-shadow: 0 2px 0 var(--ink); transform: rotate(-3deg); }
  .card-bullets li:nth-child(2) .check { background: var(--coral); transform: rotate(2deg); }
  .card-bullets li:nth-child(3) .check { background: var(--sky); transform: rotate(-2deg); }
  .card-bullets .check svg { width: 14px; height: 14px; stroke: var(--ink); stroke-width: 3; }
  .card-bullets strong { color: var(--ink); font-weight: 700; }

  .card-stage { perspective: 1200px; }
  .scard-wrap { transform-style: preserve-3d; }
  .scard {
    container-type: inline-size;
    background: var(--ink);
    border: 2.5px solid var(--ink);
    border-radius: 18px;
    aspect-ratio: 1.586;
    padding: 0 7cqw 7cqw;
    display: flex; flex-direction: column;
    color: var(--paper);
    box-shadow: 0 12px 0 rgba(14,14,24,0.18), 0 30px 60px -30px rgba(14,14,24,0.45);
    position: relative; overflow: hidden;
    background-image: radial-gradient(circle, rgba(200,241,84,0.10) 1px, transparent 1px);
    background-size: 18px 18px;
    transform: rotate(-3deg);
  }
  .scard > * { position: relative; z-index: 1; }
  .scard-word {
    position: absolute; z-index: 0; top: 0; left: 50%;
    transform: translate(-50%, -46%);
    font-family: var(--font-display); font-weight: 700;
    font-variation-settings: "opsz" 30;
    font-size: 26.5cqw; line-height: 1; letter-spacing: -0.045em;
    color: var(--lime); white-space: nowrap; user-select: none; pointer-events: none;
  }
  .scard-handle { margin-top: auto; margin-bottom: 3cqw; font-family: var(--font-mono); font-size: 6.6cqw; letter-spacing: 0.08em; opacity: 0.94; }
  .scard-bottom { display: flex; justify-content: space-between; align-items: center; }
  .scard-tap { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 3.2cqw; text-transform: uppercase; letter-spacing: 0.14em; opacity: 0.8; }
  .scard-tap .icon { width: 4cqw; height: 4cqw; stroke: var(--lime); fill: none; }
  .scard-mc { display: inline-flex; }
  .scard-mc i { width: 7.5cqw; height: 7.5cqw; border-radius: 50%; display: block; }
  .scard-mc i:first-child { background: var(--coral); opacity: 0.92; }
  .scard-mc i:last-child { background: var(--butter); opacity: 0.92; margin-left: -3cqw; }
  .scard-meta {
    margin-top: 28px; display: flex; align-items: center; justify-content: center; gap: 10px;
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); font-weight: 600;
  }
  .scard-meta .live { width: 8px; height: 8px; border-radius: 50%; background: var(--lime-deep); animation: pulse 1.4s ease-in-out infinite; }

  .perks-strip {
    margin-top: 80px;
    background: var(--paper-elevated);
    border: 2.5px solid var(--ink);
    border-radius: 28px;
    padding: 36px 40px;
    box-shadow: 0 6px 0 var(--ink);
    display: grid;
    grid-template-columns: 1.1fr 1.4fr;
    gap: 28px 40px;
    align-items: center;
    position: relative;
  }
  .perks-lead .section-eyebrow { margin-bottom: 14px; }
  .perks-text { font-family: var(--font-display); font-size: 22px; line-height: 1.2; letter-spacing: -0.02em; color: var(--ink-soft); }
  .perks-text strong { color: var(--ink); }
  .perks-chips { display: flex; flex-wrap: wrap; gap: 12px; }
  .perk-chip {
    display: inline-flex; align-items: baseline; gap: 8px;
    font-family: var(--font-display); font-weight: 700; font-size: 19px; letter-spacing: -0.02em;
    padding: 10px 16px; border-radius: 14px;
    border: 2px solid var(--ink); box-shadow: 0 3px 0 var(--ink);
    background: var(--lime);
    transform: rotate(var(--r, 0deg));
    transition: transform 250ms var(--ease-spring);
  }
  .perk-chip em { font-style: normal; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6; }
  .perk-chip:hover { transform: rotate(calc(var(--r, 0deg) * -1)) scale(1.06) translateY(-2px); }
  .perk-chip:nth-child(1) { --r: -2deg; background: var(--lime); }
  .perk-chip:nth-child(2) { --r: 2deg; background: var(--butter); }
  .perk-chip:nth-child(3) { --r: -1.5deg; background: var(--sky); }
  .perk-chip:nth-child(4) { --r: 1deg; background: var(--coral); color: var(--paper); }
  .perk-chip:nth-child(5) { --r: -2.5deg; background: var(--paper); }
  .perk-chip:nth-child(6) { --r: 1.5deg; background: var(--lime); }
  .perks-note { grid-column: 1 / -1; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--ink-muted); }

  /* ========== STATEMENT ========== */
  .statement-section { padding: 120px 0; text-align: center; background: var(--paper-deep); }
  .big-quote {
    font-family: var(--font-display);
    font-size: clamp(56px, 8vw, 116px);
    font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: var(--ink);
    margin-bottom: 32px;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 20px;
  }
  .big-quote .word {
    display: inline-block; padding: 0 20px;
    border: 3px solid var(--ink); border-radius: 14px; box-shadow: 0 6px 0 var(--ink); color: var(--ink);
    transform: rotate(var(--tilt, 0deg));
    transition: transform 300ms var(--ease-spring);
  }
  .big-quote .word:hover { transform: rotate(calc(var(--tilt, 0deg) * -1.5)) translateY(-6px); }
  .big-quote .w-lime { background: var(--lime); }
  .big-quote .w-coral { background: var(--coral); color: var(--paper); }
  .big-quote .w-sky { background: var(--sky); }
  .statement-section .section-sub { font-size: 20px; }

  /* ========== TRUST ========== */
  .trust-section { padding: 110px 0; }
  .trust-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .trust-copy h2 { font-family: var(--font-display); font-size: clamp(40px, 5vw, 64px); font-weight: 700; line-height: 0.96; letter-spacing: -0.035em; margin-bottom: 22px; }
  .trust-copy p { font-size: 18px; line-height: 1.55; color: var(--ink-soft); margin-bottom: 16px; max-width: 540px; }
  .trust-card {
    background: var(--paper-elevated); border: 2.5px solid var(--ink); border-radius: 28px; padding: 32px;
    box-shadow: 0 8px 0 var(--ink);
  }
  .trust-row { display: flex; align-items: flex-start; gap: 16px; padding: 16px 0; border-bottom: 1.5px dashed var(--line); }
  .trust-row:first-child { padding-top: 0; }
  .trust-row:last-child { padding-bottom: 0; border-bottom: none; }
  .trust-row-icon { flex-shrink: 0; width: 44px; height: 44px; border-radius: 12px; border: 2px solid var(--ink); display: grid; place-items: center; box-shadow: 0 2px 0 var(--ink); color: var(--ink); transform: rotate(-3deg); }
  .trust-row-icon svg { width: 20px; height: 20px; stroke-width: 2; }
  .trust-row:nth-child(1) .trust-row-icon { background: var(--lime); }
  .trust-row:nth-child(2) .trust-row-icon { background: var(--sky); transform: rotate(2deg); }
  .trust-row:nth-child(3) .trust-row-icon { background: var(--coral); color: var(--paper); }
  .trust-row:nth-child(4) .trust-row-icon { background: var(--butter); transform: rotate(3deg); }
  .trust-row-title { font-family: var(--font-display); font-size: 17px; font-weight: 700; letter-spacing: -0.015em; margin-bottom: 3px; }
  .trust-row-desc { font-size: 14px; color: var(--ink-muted); line-height: 1.45; }
  .audd-link {
    color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px;
    text-decoration-color: var(--lime); font-weight: 700; transition: text-decoration-color 200ms ease;
  }
  .audd-link:hover { text-decoration-color: var(--ink); }

  /* ========== FAQ ========== */
  .faq-section { padding: 110px 0; background: var(--paper-deep); }
  .faq-section .faq-list { margin-top: 48px; }

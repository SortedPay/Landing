  .how-num {
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 700;
    line-height: 0.85;
    color: var(--lime);
    margin-bottom: 16px;
    letter-spacing: -0.04em;
  }
  .how-icon {
    position: absolute;
    top: 32px; right: 32px;
    width: 44px; height: 44px;
    border-radius: 12px;
    background: rgba(200, 241, 84, 0.1);
    border: 1.5px solid rgba(200, 241, 84, 0.3);
    display: grid;
    place-items: center;
    color: var(--lime);
  }
  .how-icon svg { width: 20px; height: 20px; stroke-width: 2; }
  .how-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .how-desc { font-size: 15.5px; line-height: 1.55; color: rgba(246,242,233,0.7); }
  .how-tag {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--lime);
    background: rgba(200, 241, 84, 0.08);
    padding: 4px 10px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid rgba(200, 241, 84, 0.2);

---
import Base from '@/layouts/Base.astro';
import Marquee from '@/components/Marquee.astro';
import PageCTA from '@/components/PageCTA.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import StickerMark from '@/components/StickerMark.astro';
import P2PAnimation from '@/components/P2PAnimation.astro';

const title = 'Sorted — Money. Sorted. Free, instant payments for Aussies.';
const description = 'Send to any @handle in seconds, then tap to pay everywhere else with the Sorted card. The peer-to-peer payments app built for everyday Aussies.';
---

<Base title={title} description={description}>

<section class="hero dotgrid dotgrid-hero">
  <div class="container hero-grid">
    <div>
      <h1 class="hero-title">
        Money,<br><span class="hl">sorted.</span>
      </h1>
      <p class="hero-sub">
        Send to any <strong>@handle</strong> in seconds. Tap to pay everywhere else.<br><strong>Free. Instant. Sorted.</strong>
      </p>
      <div class="hero-actions">
        <a data-claim href="#" class="btn btn-primary btn-lg">Claim your handle <svg class="icon"><use href="#i-arrow-right"/></svg></a>
        <a href="/how-it-works" class="btn btn-secondary btn-lg">How it works</a>
      </div>
      <div class="hero-trust">
        <div class="trust-item">
          <div class="trust-num"><span data-count="0" data-prefix="$">$0</span></div>
          <div class="trust-label">Send. Receive.<br>Top up. Forever.</div>
        </div>
        <div class="trust-item">
          <div class="trust-num"><span data-count="2" data-prefix="<" data-decimals="0">&lt;2</span><span class="unit">sec</span></div>
          <div class="trust-label">From tap<br>to balance</div>
        </div>
        <div class="trust-item">
          <div class="trust-num">24/7</div>
          <div class="trust-label">Saturday night,<br>Christmas morning</div>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="phone">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <div class="phone-status"><span>9:41</span><span>● ● ●</span></div>
          <div class="phone-header">
            <div class="ph-greet-block">
              <span class="ph-handle">@hannah</span>
              <span class="ph-greeting">G'day, Hannah</span>
            </div>
            <div class="ph-bell"><svg class="icon"><use href="#i-bell"/></svg></div>
          </div>
          <div class="ph-balance">
            <div class="ph-balance-label">Available balance</div>
            <div class="ph-balance-amt">$1,247<span class="cents">.50</span><span class="ccy">AUD</span></div>
            <div class="ph-earn-pill"><span class="live-tick"></span> +12 Sorted Points</div>
          </div>
          <div class="ph-actions">
            <div class="ph-action">
              <div class="ph-action-icon send"><svg class="icon"><use href="#i-send"/></svg></div>
              <span class="ph-action-label">Send</span>
            </div>
            <div class="ph-action">
              <div class="ph-action-icon receive"><svg class="icon"><use href="#i-receive"/></svg></div>
              <span class="ph-action-label">Receive</span>
            </div>
            <div class="ph-action">
              <div class="ph-action-icon topup"><svg class="icon"><use href="#i-plus"/></svg></div>
              <span class="ph-action-label">Top up</span>
            </div>
          </div>
          <div class="ph-section-label">Recent</div>
          <div class="ph-activity-row">
            <div class="ph-act-avatar a1">MT</div>
            <div class="ph-act-info">
              <div class="ph-act-name">Maya Thompson</div>
              <div class="ph-act-meta">@maya · 2 min ago</div>
            </div>
            <div class="ph-act-amt out">−$24.00</div>
          </div>
          <div class="ph-activity-row">
            <div class="ph-act-avatar a2">JL</div>
            <div class="ph-act-info">
              <div class="ph-act-name">Jack Lawson</div>
              <div class="ph-act-meta">@jackl · 18 min ago</div>
            </div>
            <div class="ph-act-amt in">+$85.00</div>
          </div>
          <div class="ph-activity-row">
            <div class="ph-act-avatar a3">CC</div>
            <div class="ph-act-info">
              <div class="ph-act-name">Corner Cafe</div>
              <div class="ph-act-meta">Card tap · 9:41 am</div>
            </div>
            <div class="ph-act-amt out">−$5.50</div>
          </div>
        </div>
      </div>
      <div class="float-card float-card-1">
        <div class="float-icon lime"><svg class="icon"><use href="#i-zap"/></svg></div>
        <div>
          <div class="float-text">$50 sent</div>
          <div class="float-sub">Settled in 1.4s</div>
        </div>
      </div>
      <div class="float-card float-card-2">
        <div class="float-icon coral"><svg class="icon"><use href="#i-trending"/></svg></div>
        <div>
          <div class="float-text">+24 Sorted Points</div>
          <div class="float-sub">Earned this week</div>
        </div>
      </div>
    </div>
  </div>
</section>

<Marquee
  bgAbove="var(--paper)"
  bgBelow="var(--paper)"
  ribbon="var(--lime)"
  ink="var(--ink)"
  phrases={[
    'FREE FOREVER',
    'INSTANT',
    'NO BSB',
    'NO FEES',
    'NO DRAMA',
    'BUILT IN AUSTRALIA',
  ]}
/>

<!-- Why Sorted -->
<section class="why-us reveal" id="why">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Built for everyday <span class="hl">Aussies.</span></h2>
      <p class="section-sub">Shouting Maccas. Paying your mate back. Sending Mum a hundred for her birthday. None of it should cost you a cent.</p>
    </div>

    <P2PAnimation />

    <div class="usp-stack">
      <div class="usp-card">
        <h3 class="usp-headline">No BSBs. <span class="stress">No drama.</span></h3>
        <p class="usp-body">Every account has a <strong>@handle</strong>. Short, memorable, yours. No more texting Mum for her account number for the fifth time. Type a handle, slide to send — lands before you've put your phone down.</p>
      </div>

      <div class="usp-card">
        <h3 class="usp-headline">Just open it. <span class="stress">And send.</span></h3>
        <p class="usp-body">No wallets. No seed phrases. No gas fees. Sign in with your number, pick a handle, you're done. We do all the boring bits.</p>
      </div>

      <div class="usp-card">
        <h3 class="usp-headline">Real Aussie dollars. <span class="stress">Real Aussie banks.</span></h3>
        <p class="usp-body">Your money sits in tier-1 Australian banks. Backed 1:1, redeemable any time. Not offshore. Not crypto. Just dollars.</p>
      </div>

      <div class="usp-card">
        <h3 class="usp-headline">Oh, and normal stuff <span class="stress">earns points.</span></h3>
        <p class="usp-body">Sending mates, tapping your card — it all stacks <strong>Sorted Points</strong>, and points unlock perks at local Aussie businesses. <a href="#locals" class="audd-link">Meet the locals →</a></p>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="how-section reveal" id="how">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Easy as. <span class="hl">Three taps.</span></h2>
      <p class="section-sub">Whether it's a $5 coffee debt or splitting rent with three flatmates — same flow, same speed, same zero fees.</p>
    </div>
    <div class="how-grid reveal-stagger">
      <div class="how-step">
        <div class="how-icon"><svg class="icon"><use href="#i-plus"/></svg></div>
        <div class="how-num">01</div>
        <h3 class="how-title">Top up free</h3>
        <p class="how-desc">Link your bank once. Move money in instantly via PayID. No card surcharge, no "1% loading fee".</p>
      </div>
      <div class="how-step">
        <div class="how-icon"><svg class="icon"><use href="#i-at"/></svg></div>
        <div class="how-num">02</div>
        <h3 class="how-title">Send to @anyone</h3>
        <p class="how-desc">Type a handle, slide to send. Lands in under two seconds. Saturday night, Christmas morning, doesn't matter.</p>
      </div>
      <div class="how-step">
        <div class="how-icon"><svg class="icon"><use href="#i-trending"/></svg></div>
        <div class="how-num">03</div>
        <h3 class="how-title">Tap to pay</h3>
        <p class="how-desc">The Sorted card turns your balance into everyday money — the cafe, the servo, online. Anywhere Mastercard works.</p>
      </div>
    </div>
  </div>
</section>

<SectionDivider bgAbove="var(--ink)" bgBelow="var(--paper)" ribbon="var(--butter)" ink="var(--ink)" label="SEND TO ANYONE · EVEN YOUR NAN" />

<!-- Send to anyone — SMS flow -->
<section class="anyone-section reveal" id="anyone">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow">No app required</span>
      <h2 class="section-title">Send to <span class="hl hl-butter">anyone.</span><br>Even your nan.</h2>
      <p class="section-sub">They don't need the app. They don't need a handle. They don't need to know what Solana is.<br><strong>Just type their number. We do the rest.</strong></p>
    </div>

    <div class="anyone-grid reveal-stagger">
      <!-- Step 1: You send -->
      <div class="anyone-card">
        <span class="anyone-tag">01 · You</span>
        <h3 class="anyone-title">Type their number.<br>Tap send.</h3>
        <p class="anyone-desc">No handle? No worries. Pop in their mobile and you're done in three taps.</p>
        <div class="nan-shot">
          <div class="nan-shot-row"><span class="nan-shot-label">To</span><span class="nan-shot-value">Mum · 0412 345 678</span></div>
          <div class="nan-shot-amount">$100<span class="dim">.00</span></div>
          <div class="nan-shot-btn nan-shot-btn--ink">Hold to send →</div>
        </div>
      </div>

      <!-- Step 2: They get a text -->
      <div class="anyone-card anyone-card--sky">
        <span class="anyone-tag">02 · They get a text</span>
        <h3 class="anyone-title">Auto-text<br>does the heavy lifting.</h3>
        <p class="anyone-desc">From a real Aussie number. Reads like a friend sent it — because, well, a friend did.</p>
        <div class="nan-shot">
          <div class="nan-shot-row"><span class="nan-shot-label">SMS</span><span class="nan-shot-value">From Sorted · now</span></div>
          <div class="nan-bubble"><strong>Hannah sent you $100.</strong> Tap to&nbsp;claim&nbsp;→<br><span class="nan-bubble-link">sorted.au/c/9F2X</span></div>
        </div>
      </div>

      <!-- Step 3: They claim -->
      <div class="anyone-card anyone-card--lime">
        <span class="anyone-tag">03 · They claim</span>
        <h3 class="anyone-title">60 seconds<br>and it's theirs.</h3>
        <p class="anyone-desc">Tap the link. Pick a handle. Money's in their balance. They keep it forever — or send it on.</p>
        <div class="nan-shot nan-shot--ink">
          <div class="nan-shot-row"><span class="nan-shot-label nan-shot-label--lime">Claim</span><span class="nan-shot-value nan-shot-value--paper">from @hannah</span></div>
          <div class="nan-shot-amount nan-shot-amount--paper">$100<span class="dim">.00</span></div>
          <div class="nan-shot-btn nan-shot-btn--lime">Claim in Sorted →</div>
        </div>
      </div>
    </div>

    <!-- Peace of mind callout -->
    <div class="anyone-callout reveal">
      <div class="anyone-callout-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      </div>
      <div class="anyone-callout-body">
        <strong>You can undo for 24 hours.</strong> Changed your mind? Tap undo, money's back in your balance. Reminder pings both of you after 12 hours if it's still unclaimed.
      </div>
    </div>
  </div>
</section>

<SectionDivider bgAbove="var(--paper)" bgBelow="var(--paper)" ribbon="var(--coral)" ink="var(--ink)" label="SEND · TAP · SORTED · FREE P2P · MADE IN AUS" />

<!-- Card — tap to pay -->
<section class="earn-section dotgrid reveal" id="card">
  <div class="container">
    <div class="earn-grid">
      <div class="earn-copy">
        <h2>Tap to pay, <span class="hl">everywhere.</span></h2>
        <p>Your balance isn't stuck in an app. The Sorted card turns it into everyday money — the cafe, the servo, the big shop, online. Anywhere Mastercard works, your money works.</p>
        <ul class="earn-bullets">
          <li>
            <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Anywhere Mastercard works.</strong> Tap your phone or the card itself. In store, online, here or overseas.</span>
          </li>
          <li>
            <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Freeze it in one tap.</strong> Misplaced the card? Freeze it from the app in a second. Unfreeze just as fast.</span>
          </li>
          <li>
            <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span><strong>Every tap earns Sorted Points.</strong> Doing normal stuff earns points — points unlock perks at local Aussie businesses.</span>
          </li>
        </ul>
      </div>
      <div class="earn-card spring-in">
        <div class="scard">
          <span class="scard-word" aria-hidden="true">sorted.</span>
          <div class="scard-handle">@hannah</div>
          <div class="scard-bottom">
            <span class="scard-tap"><svg class="icon"><use href="#i-zap"/></svg> Tap to pay</span>
            <span class="scard-mc"><i></i><i></i></span>
          </div>
        </div>
        <div class="scard-meta">Mastercard network · Freeze anytime · Earns Sorted Points</div>
        <div class="earn-card-divider"></div>
        <div class="earn-card-foot">
          <span class="live"></span>
          <span>Rolling out with launch. Claim your handle to be first.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Locals — Sorted Perks backs local Aussie businesses -->
<section class="locals-section reveal" id="locals">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow">Sorted Perks</span>
      <h2 class="section-title">Backing the <span class="hl hl-butter">locals.</span></h2>
      <p class="section-sub">Your Sorted Points unlock perks at local Aussie businesses — the cafes, pubs and bakeries that make your suburb yours.<br><strong>Every perk puts a customer through a local door.</strong></p>
    </div>
    <div class="locals-grid reveal-stagger">
      <div class="locals-tile"><span class="locals-cat">Cafes</span><span class="locals-soon">Perks soon</span></div>
      <div class="locals-tile"><span class="locals-cat">Pubs</span><span class="locals-soon">Perks soon</span></div>
      <div class="locals-tile"><span class="locals-cat">Bakeries</span><span class="locals-soon">Perks soon</span></div>
      <div class="locals-tile"><span class="locals-cat">Grocers</span><span class="locals-soon">Perks soon</span></div>
      <div class="locals-tile"><span class="locals-cat">Barbers</span><span class="locals-soon">Perks soon</span></div>
      <div class="locals-tile"><span class="locals-cat">Bookshops</span><span class="locals-soon">Perks soon</span></div>
    </div>
    <p class="locals-note">Run a local? Partnerships open with launch — say g'day on X and get in early.</p>
  </div>
</section>

<!-- Big statement -->
<section class="statement-section reveal">
  <div class="container">
    <div class="statement-block">
      <h2 class="big-quote">
        <span class="word w-lime">FAST.</span>
        <span class="word w-coral">FREE.</span>
        <span class="word w-sky">SORTED.</span>
      </h2>
      <p class="section-sub" style="font-size: 20px;">No fees. No BSBs. No three-day waits. Just send.</p>
      <div class="statement-stats">
        <div class="ss-cell">
          <div class="ss-num"><span data-count="0" data-prefix="$">$0</span></div>
          <div class="ss-label">Fees to send, receive, top up, or hold</div>
        </div>
        <div class="ss-cell">
          <div class="ss-num"><span data-count="1.4" data-decimals="1">1.4</span><span class="unit"> sec</span></div>
          <div class="ss-label">Average tap-to-balance time</div>
        </div>
        <div class="ss-cell">
          <div class="ss-num">24/7</div>
          <div class="ss-label">Saturday night, Boxing Day, 3am</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Trust -->
<section class="trust-section reveal">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-section-copy">
        <h2>Fair dinkum <span class="hl hl-sky">AUD.</span></h2>
        <p>Your balance is backed 1:1 by AUDD, the Australian dollar stablecoin issued by AUDC Pty Ltd under an Australian Financial Services Licence. Reserves sit in <strong>tier-1 Aussie banks</strong>. Real dollars. Real banks. Real Australia. AUDD-first, with USDC and USDT supported.</p>
        <p>Solana's just the rails — fast, cheap, invisible. It's what makes the under-two-second sends possible. You'll never see it.</p>
        <p style="margin-top: 24px;"><a href="https://audd.digital" target="_blank" rel="noopener" class="audd-link">More about AUDD →</a></p>
      </div>
      <div class="trust-card">
        <div class="trust-row">
          <div class="trust-row-icon"><svg class="icon"><use href="#i-shield"/></svg></div>
          <div class="trust-row-body">
            <div class="trust-row-title">AFSL-regulated</div>
            <div class="trust-row-desc">AUDD is issued by AUDC Pty Ltd under an Australian Financial Services Licence.</div>
          </div>
        </div>
        <div class="trust-row">
          <div class="trust-row-icon"><svg class="icon"><use href="#i-lock"/></svg></div>
          <div class="trust-row-body">
            <div class="trust-row-title">1:1 backed</div>
            <div class="trust-row-desc">Every dollar is a real Australian dollar, redeemable any time.</div>
          </div>
        </div>
        <div class="trust-row">
          <div class="trust-row-icon"><svg class="icon"><use href="#i-globe"/></svg></div>
          <div class="trust-row-body">
            <div class="trust-row-title">Reserves at home</div>
            <div class="trust-row-desc">Tier-1 Aussie banks, not offshore. Fully reserved, always redeemable.</div>
          </div>
        </div>
        <div class="trust-row">
          <div class="trust-row-icon"><svg class="icon"><use href="#i-zap"/></svg></div>
          <div class="trust-row-body">
            <div class="trust-row-title">Solana rails</div>
            <div class="trust-row-desc">Sub-second settlement, fractions of a cent in network cost. We cover it.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<SectionDivider bgAbove="var(--paper)" bgBelow="var(--paper-deep)" ribbon="var(--sky)" ink="var(--ink)" label="GOT QUESTIONS · WE'VE GOT ANSWERS" />

<!-- FAQ -->
<section class="faq-section reveal" id="faq">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Got <span class="hl hl-coral">questions?</span></h2>
      <p class="section-sub">No legalese. No fine print. Just the good oil.</p>
    </div>
    <div class="faq-list">
      <details class="faq-item">
        <summary class="faq-q">How fast is "instant"?<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
        <div class="faq-a">Under two seconds, tap to balance. Not "next business day". Not "between 1–3 business days". Two seconds. Saturday night, Boxing Day, 3am on a Tuesday — same speed.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Do I need a wallet or anything crypto-y?<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
        <div class="faq-a">Nope. Sign in with your phone, pick a <strong>@handle</strong>, you're in. The Solana settlement layer is just plumbing — same way you don't think about TCP/IP when you send a text. We do the boring bits so you can just send money.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">How does the free model actually work?<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
        <div class="faq-a">Not from your pocket. We earn on card transactions, optional extras like instant cashouts, and partnerships with the businesses in Sorted Perks. <strong>Sending money to mates is free and stays free.</strong> Send. Receive. Top up. All free, forever.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Where's my money actually kept?<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
        <div class="faq-a">In <strong>tier-1 Australian bank accounts</strong>, backed 1:1 by AUDD — the Australian dollar stablecoin issued by AUDC Pty Ltd under an Australian Financial Services Licence. Your balance is always redeemable for real AUD, any time. Not offshore. Not in stablecoins of stablecoins. Real Aussie dollars in real Aussie banks.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Will my balance ever earn anything?<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
        <div class="faq-a">Not right now — and we won't pretend otherwise. Down the track we're exploring ways to make idle balances do more, subject to the right regulatory settings. No promises, no fine print. Today the deal is simple: free sends to mates, the Sorted card, and Sorted Points for doing normal stuff.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Can I send overseas?<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
        <div class="faq-a">Not yet — but it's coming. We're nailing Aussie P2P and the Sorted card first; international sends are next on the list. Sign up to be first in line.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">How do I get money in and out?<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
        <div class="faq-a"><strong>PayID, instantly.</strong> Top up: send from your bank to your Sorted PayID, lands in seconds. Cash out: send back to your bank, same speed, same zero cost. No card surcharges, no "1% loading fee" hiding at the bottom of the screen.</div>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Who's making this?<span class="faq-chevron"><svg><use href="#i-chevron-down"/></svg></span></summary>
        <div class="faq-a">A small Aussie team based in Brisbane, who got fed up with money taking three days to move between mates. We operate as an authorised representative under an Australian Financial Services Licence — proper compliance, not a "we'll sort it later" hack.</div>
      </details>
    </div>
  </div>
</section>

<Marquee
  bgAbove="var(--paper-deep)"
  bgBelow="var(--paper)"
  ribbon="var(--lime)"
  ink="var(--ink)"
  phrases={[
    "SEND THAT CASH MATE",
    "DW BRO IT'S SORTED",
    "EASY MONEY",
    "SWEET AS",
    "TOO EASY",
    "ALL GOOD",
  ]}
/>

<div class="cta-stage">
  <StickerMark color="var(--coral)" size="160px" rotate={-12} class="cta-sticker cta-sticker--left" />
  <StickerMark color="var(--lime)" size="180px" rotate={14} class="cta-sticker cta-sticker--right" />
  <PageCTA
    title="Right then.<br>Claim your <span class='hl'>@handle.</span>"
    sub="Takes 90 seconds. No card. No catch. Send your first $20 in the same minute you sign up."
    primaryLabel="Claim your handle"
    secondaryLabel="How it works"
    secondaryHref="/how-it-works"
  />
</div>

</Base>

<style>
  /* ========== LANDING PAGE STYLES ========== */
  .hero {
    padding: 80px 0 120px;
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;

---
import Base from '@/layouts/Base.astro';

const title = 'Contact — Sorted';
const description = 'Real humans, real replies, usually within a business day. Email us or use the form.';
---

<Base title={title} description={description}>
<section class="subhero dotgrid">
  <div class="container">
    <div class="crumbs"><a href="/">Sorted</a><span class="sep"></span><span>Company</span><span class="sep"></span><span>Contact</span></div>
    <span class="subhero-eyebrow">Company · Contact</span>
    <h1>Talk to <span class="hl">us.</span></h1>
    <p class="subhero-sub">No automated triage, no chatbot. A small team reads every message and gets back within a business day. Usually faster.</p>
  </div>
</section>
<section class="section reveal"><div class="container">
    <div class="two-col">
      <div>
        <h2 class="section-title section-title--left">By topic.</h2>
        <div class="info-card">
          <div class="info-card-eyebrow">Support</div>
          <h3 class="info-card-title">Something broken or weird?</h3>
          <p class="info-card-body">Email <a class="inline-link" href="mailto:hello@paymentsorted.com">hello@paymentsorted.com</a> with a description and a screenshot. In the app, Settings → Send feedback pre-fills your build details.</p>
        </div>
        <div class="info-card">
          <div class="info-card-eyebrow">Security</div>
          <h3 class="info-card-title">Found a vulnerability?</h3>
          <p class="info-card-body">Email <a class="inline-link" href="mailto:security@paymentsorted.com">security@paymentsorted.com</a>. We respond within 24 hours and credit responsible disclosures. More on the <a class="inline-link" href="/security">security page</a>.</p>
        </div>
        <div class="info-card">
          <div class="info-card-eyebrow">Privacy &amp; complaints</div>
          <h3 class="info-card-title">Your data, or a dispute.</h3>
          <p class="info-card-body">Data requests go to <a class="inline-link" href="mailto:privacy@paymentsorted.com">privacy@paymentsorted.com</a>. Complaints go to <a class="inline-link" href="mailto:hello@paymentsorted.com?subject=Complaint">hello@paymentsorted.com</a> with "Complaint" in the subject; unresolved ones can be escalated to AFCA.</p>
        </div>
        <div class="info-card">
          <div class="info-card-eyebrow">Press, partners, locals</div>
          <h3 class="info-card-title">Working on a story, or run a local?</h3>
          <p class="info-card-body">Same inbox, <a class="inline-link" href="mailto:hello@paymentsorted.com">hello@paymentsorted.com</a>. Put "Press", "Partnership" or "Sorted Perks" in the subject so it lands with the right person. Press details on the <a class="inline-link" href="/press">press page</a>.</p>
        </div>
      </div>
      <div>
        <h2 class="section-title section-title--left">Or just write.</h2>
        <form class="info-card contact-form" data-contact-form novalidate>
          <div class="form-group">
            <label class="form-label" for="contact-name">Your name</label>
            <input class="form-input" id="contact-name" name="name" type="text" autocomplete="name" placeholder="Hannah Reid" required maxlength="120">
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-email">Email</label>
            <input class="form-input" id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-message">What's on your mind?</label>
            <textarea class="form-textarea" id="contact-message" name="message" placeholder="As much detail as you like. We read everything." required minlength="5" maxlength="5000"></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-lg contact-form-submit" data-contact-submit>Send <svg class="icon"><use href="#i-send"/></svg></button>
          <p class="contact-form-status" data-contact-status aria-live="polite" hidden></p>
        </form>
        <div class="callout">
          <div class="callout-icon"><svg><use href="#i-clock"/></svg></div>
          <div class="callout-body"><strong>Response time:</strong> usually under four business hours. Always under one business day.</div>
        </div>
      </div>
    </div></div></section>
<section class="section alt reveal"><div class="container">
    <div class="prose prose--center">
      <h2>Where we are.</h2>
      <p>Sorted Pty Ltd is based in Brisbane, Queensland. We don't run a walk-in office; email is the fastest way to reach us.</p>
    </div></div></section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-contact-status]');
  const submit = document.querySelector<HTMLButtonElement>('[data-contact-submit]');

  function show(message: string, kind: 'ok' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.dataset.kind = kind;
    status.hidden = false;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const fd = new FormData(form);
    const payload = {
      name: String(fd.get('name') || '').trim(),
      email: String(fd.get('email') || '').trim(),
      message: String(fd.get('message') || '').trim(),
    };
    if (submit) submit.disabled = true;
    show('Sending…', 'ok');
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data || !data.ok) {
        throw new Error((data && data.error) || `HTTP ${res.status}`);
      }
      form.reset();
      show("Got it. We'll reply within a business day.", 'ok');
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Something went wrong.';
      show(`${msg} You can also email hello@paymentsorted.com.`, 'error');
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>

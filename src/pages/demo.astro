---
import Base from '@/layouts/Base.astro';

const title = 'Try Sorted — Live Demo';
const description = "Tap through Sorted. Send a payment, top up, check yield. No signup, just a click-through demo on your screen.";
---

<Base title={title} description={description}>
  <main class="demo-stage">
    <div class="demo-bg-blob demo-bg-blob--1"></div>
    <div class="demo-bg-blob demo-bg-blob--2"></div>

    <div class="demo-frame-wrap">
      <!-- Caption bubbles -->
      <div class="caption caption--tl" data-caption="tl" hidden><div class="caption-arrow caption-arrow--br"></div><span class="caption-text"></span></div>
      <div class="caption caption--tr" data-caption="tr" hidden><div class="caption-arrow caption-arrow--bl"></div><span class="caption-text"></span></div>
      <div class="caption caption--bl" data-caption="bl" hidden><div class="caption-arrow caption-arrow--tr"></div><span class="caption-text"></span></div>
      <div class="caption caption--br" data-caption="br" hidden><div class="caption-arrow caption-arrow--tl"></div><span class="caption-text"></span></div>

      <!-- iPhone 15 Pro frame -->
      <div class="iphone" id="iphone">
        <div class="iphone-btn iphone-btn--mute"></div>
        <div class="iphone-btn iphone-btn--vol-up"></div>
        <div class="iphone-btn iphone-btn--vol-down"></div>
        <div class="iphone-btn iphone-btn--power"></div>
        <div class="iphone-bezel">
          <div class="iphone-screen" id="screen">
            <div class="dynamic-island"></div>
            <div class="status-bar">
              <span class="status-time">9:41</span>
              <span class="status-icons">
                <svg width="16" height="11" viewBox="0 0 16 11" fill="currentColor"><rect x="0" y="7" width="3" height="4" rx="0.5"/><rect x="4" y="5" width="3" height="6" rx="0.5"/><rect x="8" y="3" width="3" height="8" rx="0.5"/><rect x="12" y="1" width="3" height="10" rx="0.5"/></svg>
                <svg width="15" height="11" viewBox="0 0 15 11" fill="currentColor"><path d="M7.5 0C4.5 0 1.86 1.06 0 2.75l1.06 1.06A8.45 8.45 0 0 1 7.5 1.5c2.55 0 4.86.94 6.44 2.31L15 2.75A11.45 11.45 0 0 0 7.5 0Zm0 3C5.34 3 3.45 3.75 2.1 4.95l1.06 1.06A6.45 6.45 0 0 1 7.5 4.5c1.73 0 3.3.64 4.34 1.51L12.9 4.95A8.45 8.45 0 0 0 7.5 3Zm0 3a2.99 2.99 0 0 0-2.12.88l1.06 1.06A1.5 1.5 0 0 1 7.5 7.5c.41 0 .78.17 1.06.44l1.06-1.06A2.99 2.99 0 0 0 7.5 6Z"/></svg>
                <svg width="24" height="11" viewBox="0 0 24 11" fill="none"><rect x="0.5" y="0.5" width="20" height="10" rx="2.5" stroke="currentColor" stroke-opacity="0.4"/><rect x="2" y="2" width="17" height="7" rx="1" fill="currentColor"/><rect x="21" y="3.5" width="1.5" height="4" rx="0.5" fill="currentColor" fill-opacity="0.4"/></svg>
              </span>
            </div>
            <div class="back-indicator" id="backIndicator"></div>
            <div class="stage" id="stage"></div>
            <div class="home-indicator"></div>
          </div>
        </div>
      </div>

      <div class="demo-controls">
        <button class="demo-control demo-control--reset" id="resetDemo" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          <span>Reset demo</span>
        </button>
        <a href="/" class="demo-control demo-control--home">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
          <span>Back to site</span>
        </a>
      </div>
    </div>

    <div class="demo-footer">
      <span class="demo-footer-dot"></span>
      <span class="demo-footer-text">Live demo · Sorted v0.1 · No real money, tap anything</span>
    </div>
  </main>

  <style is:global>
    body.demo-mode > nav.site-nav,
    body.demo-mode > footer.site-footer,
    body.demo-mode > .mobile-nav,
    body.demo-mode > .claim-modal { display: none !important; }
    body.demo-mode { background: #C8F154 !important; overflow: hidden; }
    body.demo-mode main { padding: 0; }
  </style>

  <script is:inline>document.body.classList.add('demo-mode');</script>

  <style>
    /* ============================================================
       EXACT FIGMA TOKENS
       ============================================================ */
    .iphone-screen {
      --paper: #F6F2E9;
      --paper-elevated: #FFFCF5;
      --paper-deep: #EFEADD;
      --ink: #0E0E18;
      --ink-soft: #2A2A38;
      --ink-muted: #6B6B7A;
      --line: #E5E0D2;
      --line-soft: #EDE8DA;
      --lime: #C8F154;
      --lime-deep: #A8D426;
      --lime-soft: #ECF8C7;
      --coral: #FF5A4E;
      --coral-soft: #FFE4E0;
      --sky: #5BB7FF;
      --sky-soft: #D6ECFF;
      --plum: #6B4EFF;
      --butter: #FFD66B;
      --text-primary: #0E0E18;
      --text-secondary: #2A2A38;
      --text-tertiary: #6B6B7A;
      --text-disabled: #B8B5AC;
      --text-inverse: #F6F2E9;
      --text-on-accent: #0E0E18;
      --border-strong: #0E0E18;
      --action-primary: #C8F154;
      --action-danger: #FF5A4E;
      --font-display: 'Bricolage Grotesque', system-ui, sans-serif;
      --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;
      --font-numeric: 'Inter', system-ui, sans-serif;
      --shadow-ink-sm: 0 2px 0 var(--ink);
      --shadow-ink: 0 4px 0 var(--ink);
      --shadow-ink-md: 0 6px 0 var(--ink);
      --shadow-ink-lg: 0 8px 0 var(--ink);
    }

    /* ============================================================
       DEMO STAGE
       ============================================================ */
    .demo-stage {
      min-height: 100vh;
      min-height: 100dvh;
      background: #C8F154;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
      position: relative;
      overflow: hidden;
    }
    .demo-bg-blob { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.55; pointer-events: none; z-index: 0; }
    .demo-bg-blob--1 { width: 600px; height: 600px; background: #A8D426; top: -200px; left: -200px; }
    .demo-bg-blob--2 { width: 500px; height: 500px; background: #d8f87a; bottom: -150px; right: -150px; }
    .demo-frame-wrap { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 32px; }

    /* iPhone */
    .iphone { position: relative; width: 430px; height: 880px; flex-shrink: 0; }
    .iphone::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg, #2a2a30 0%, #18181c 50%, #2a2a30 100%);
      border-radius: 58px;
      box-shadow: 0 30px 60px -10px rgba(0,0,0,0.4), 0 50px 100px -20px rgba(0,0,0,0.3), inset 0 0 0 1px rgba(255,255,255,0.05);
    }
    .iphone::after {
      content: ''; position: absolute; inset: 2px;
      border-radius: 56px;
      background: linear-gradient(135deg, #3a3a40 0%, #1a1a1e 50%, #3a3a40 100%);
      z-index: 1;
    }
    .iphone-btn {
      position: absolute;
      background: linear-gradient(180deg, #1a1a1e 0%, #28282e 50%, #1a1a1e 100%);
      z-index: 2;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), inset 0 -1px 0 rgba(0,0,0,0.4);
    }
    .iphone-btn--mute      { left: -3px; top: 110px; width: 4px; height: 28px; border-radius: 2px 0 0 2px; }
    .iphone-btn--vol-up    { left: -3px; top: 170px; width: 4px; height: 60px; border-radius: 2px 0 0 2px; }
    .iphone-btn--vol-down  { left: -3px; top: 248px; width: 4px; height: 60px; border-radius: 2px 0 0 2px; }
    .iphone-btn--power     { right: -3px; top: 180px; width: 4px; height: 100px; border-radius: 0 2px 2px 0; }
    .iphone-bezel {
      position: absolute; inset: 13px;
      background: #000;
      border-radius: 47px;
      z-index: 3;
      overflow: hidden;
      box-shadow: inset 0 0 0 2px rgba(255,255,255,0.04);
    }
    .iphone-screen {
      position: absolute; inset: 6px;
      background: #F6F2E9;
      border-radius: 41px;
      overflow: hidden;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      color: #0E0E18;
    }
    .dynamic-island {
      position: absolute; top: 11px; left: 50%; transform: translateX(-50%);
      width: 124px; height: 36px;
      background: #000; border-radius: 999px;
      z-index: 100; pointer-events: none;
    }
    .status-bar {
      position: absolute; top: 0; left: 0; right: 0;
      height: 54px;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 32px 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 600; font-size: 17px;
      color: #0E0E18;
      z-index: 90; pointer-events: none;
    }
    .status-time { font-variant-numeric: tabular-nums; }
    .status-icons { display: flex; gap: 5px; align-items: center; color: #0E0E18; }
    .home-indicator {
      position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%);
      width: 134px; height: 5px;
      background: #0E0E18; border-radius: 999px;
      opacity: 0.4; z-index: 90; pointer-events: none;
    }
    .back-indicator {
      position: absolute; left: 0; top: 0; bottom: 0; width: 0;
      background: linear-gradient(90deg, rgba(0,0,0,0.08) 0%, transparent 100%);
      z-index: 80; pointer-events: none;
      transition: width 0.05s linear;
    }
    .stage { position: absolute; inset: 54px 0 28px 0; overflow: hidden; }
    .screen {
      position: absolute; inset: 0;
      background: var(--paper);
      overflow-y: auto; overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      color: var(--text-primary);
    }
    .screen::-webkit-scrollbar { display: none; }
    .screen[data-state="entering-right"] { animation: slideInRight 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .screen[data-state="entering-left"]  { animation: slideInLeft  0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .screen[data-state="exiting-left"]   { animation: slideOutLeft 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .screen[data-state="exiting-right"]  { animation: slideOutRight 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes slideInRight  { from { transform: translateX(100%); } to { transform: translateX(0); } }
    @keyframes slideInLeft   { from { transform: translateX(-30%); opacity: 0.5; } to { transform: translateX(0); opacity: 1; } }
    @keyframes slideOutLeft  { from { transform: translateX(0); } to { transform: translateX(-30%); opacity: 0.5; } }
    @keyframes slideOutRight { from { transform: translateX(0); } to { transform: translateX(100%); } }

    /* ============================================================
       FIGMA PRIMITIVES — Exact tokens
       ============================================================ */
    .scr-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px 12px; }
    .scr-back {
      width: 40px; height: 40px;
      border-radius: 999px;
      background: var(--paper-elevated);
      border: 1px solid var(--line);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      font-family: var(--font-display); font-weight: 700; font-size: 18px;
      color: var(--text-primary);
      transition: transform 0.1s ease;
      padding: 0;
    }
    .scr-back:active { transform: scale(0.92); }
    .scr-spacer-40 { width: 40px; height: 40px; flex-shrink: 0; }

    /* Eyebrow scales (Figma text styles) */
    .scr-eyebrow-md {
      font-family: var(--font-mono); font-weight: 500;
      font-size: 11px; line-height: 16px;
      letter-spacing: 1.98px;
      color: var(--text-tertiary);
      text-transform: uppercase;
    }
    .scr-eyebrow-sm {
      font-family: var(--font-mono); font-weight: 500;
      font-size: 10px; line-height: 14px;
      letter-spacing: 1.6px;
      color: var(--text-tertiary);
      text-transform: uppercase;
    }

    /* Display headings (Figma text styles) */
    .scr-h1 { font-family: var(--font-display); font-weight: 700; font-size: 56px; line-height: 56px; letter-spacing: -2.24px; margin: 0; }
    .scr-h2 { font-family: var(--font-display); font-weight: 700; font-size: 40px; line-height: 40px; letter-spacing: -1.4px; margin: 0; }
    .scr-h3 { font-family: var(--font-display); font-weight: 700; font-size: 32px; line-height: 36px; letter-spacing: -0.96px; margin: 0; }
    .scr-h4 { font-family: var(--font-display); font-weight: 700; font-size: 24px; line-height: 28px; letter-spacing: -0.6px; margin: 0; }
    .scr-h5 { font-family: var(--font-display); font-weight: 700; font-size: 20px; line-height: 24px; letter-spacing: -0.3px; margin: 0; }
    .scr-h6 { font-family: var(--font-display); font-weight: 700; font-size: 16px; line-height: 20px; letter-spacing: -0.16px; margin: 0; }

    .scr-body-md { font-family: var(--font-body); font-weight: 500; font-size: 14px; line-height: 20px; color: var(--text-secondary); }
    .scr-body-sm { font-family: var(--font-body); font-weight: 500; font-size: 12px; line-height: 18px; color: var(--text-secondary); }
    .scr-body-xs { font-family: var(--font-body); font-weight: 500; font-size: 11px; line-height: 16px; letter-spacing: -0.11px; color: var(--text-tertiary); }
    .scr-label-md { font-family: var(--font-body); font-weight: 600; font-size: 14px; line-height: 18px; letter-spacing: -0.14px; color: var(--text-primary); }

    /* Numeric (Inter) */
    .scr-num-hero { font-family: var(--font-numeric); font-weight: 700; font-size: 92px; line-height: 92px; letter-spacing: -3.68px; }
    .scr-num-lg   { font-family: var(--font-numeric); font-weight: 700; font-size: 56px; line-height: 56px; letter-spacing: -2.24px; }
    .scr-num-md   { font-family: var(--font-numeric); font-weight: 700; font-size: 24px; line-height: 28px; letter-spacing: -0.48px; }
    .scr-num-sm   { font-family: var(--font-numeric); font-weight: 700; font-size: 17px; line-height: 20px; }

    /* Avatar — exact Figma sizes */
    .scr-avatar {
      border-radius: 999px;
      border: 2px solid var(--border-strong);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-body); font-weight: 600; letter-spacing: -0.14px;
      color: var(--text-on-accent);
      flex-shrink: 0;
      overflow: hidden;
    }
    .scr-avatar--sm   { width: 28px;  height: 28px;  font-size: 10px; }
    .scr-avatar--md   { width: 40px;  height: 40px;  font-size: 14px; }
    .scr-avatar--lg   { width: 56px;  height: 56px;  font-size: 18px; border-width: 2.5px; }
    .scr-avatar--xl   { width: 76px;  height: 76px;  font-size: 24px; border-width: 2.5px; }
    .scr-avatar--huge { width: 112px; height: 112px; font-size: 36px; border-width: 3px; box-shadow: var(--shadow-ink-md); }
    .scr-avatar--lime   { background: var(--lime); color: var(--text-on-accent); }
    .scr-avatar--coral  { background: var(--coral); color: var(--text-inverse); }
    .scr-avatar--sky    { background: var(--sky); color: var(--text-on-accent); }
    .scr-avatar--butter { background: var(--butter); color: var(--text-on-accent); }
    .scr-avatar--plum   { background: var(--plum); color: var(--text-inverse); }

    /* Tile */
    .scr-tile {
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .scr-tile--sm   { width: 56px;  height: 56px;  font-size: 22px; border-radius: 16px; border: 2px solid var(--border-strong); box-shadow: var(--shadow-ink-sm); }
    .scr-tile--md   { width: 64px;  height: 64px;  font-size: 26px; border-radius: 20px; border: 2px solid var(--border-strong); box-shadow: var(--shadow-ink); }
    .scr-tile--lg   { width: 80px;  height: 80px;  font-size: 32px; border-radius: 24px; border: 2.5px solid var(--border-strong); box-shadow: var(--shadow-ink-md); }
    .scr-tile--lime   { background: var(--lime); }
    .scr-tile--coral  { background: var(--coral); }
    .scr-tile--sky    { background: var(--sky); }
    .scr-tile--butter { background: var(--butter); }
    .scr-tile--paper  { background: var(--paper-elevated); }

    /* Button */
    .scr-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      border: 2px solid var(--border-strong);
      cursor: pointer;
      font-family: var(--font-body);
      color: var(--text-primary);
      text-decoration: none;
      transition: transform 0.08s ease, box-shadow 0.08s ease;
      position: relative;
      box-sizing: border-box;
      overflow: hidden;
    }
    .scr-btn:active { transform: translateY(3px); }
    .scr-btn--sm { padding: 8px 14px;  border-radius: 10px; font-size: 13px; font-weight: 600; letter-spacing: -0.13px; box-shadow: var(--shadow-ink-sm); }
    .scr-btn--md { padding: 12px 18px; border-radius: 12px; font-size: 14px; font-weight: 600; letter-spacing: -0.14px; box-shadow: var(--shadow-ink); }
    .scr-btn--lg { padding: 16px 20px; border-radius: 14px; font-size: 16px; font-weight: 700; letter-spacing: -0.16px; box-shadow: var(--shadow-ink-md); }
    .scr-btn--sm:active { box-shadow: 0 0 0 var(--ink); }
    .scr-btn--md:active { box-shadow: 0 1px 0 var(--ink); }
    .scr-btn--lg:active { box-shadow: 0 2px 0 var(--ink); }
    .scr-btn--primary   { background: var(--lime); }
    .scr-btn--secondary { background: var(--paper-elevated); }
    .scr-btn--ghost     { background: transparent; border-color: transparent; box-shadow: none; }
    .scr-btn--danger    { background: var(--coral); color: var(--text-inverse); }

    /* Input */
    .scr-input {
      width: 100%;
      padding: 14px 18px;
      border-radius: 14px;
      border: 1.5px solid var(--line);
      background: var(--paper-elevated);
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 16px;
      color: var(--text-primary);
      outline: none;
      box-sizing: border-box;
      transition: border-color 0.15s ease;
    }
    .scr-input:focus { border-color: var(--border-strong); }
    .scr-input::placeholder { color: var(--text-disabled); }
    .scr-input--filled { border-width: 2px; border-color: var(--border-strong); box-shadow: var(--shadow-ink); }
    .scr-input--disabled { background: var(--paper-deep); border-style: dashed; color: var(--text-tertiary); cursor: not-allowed; }

    /* Toggle */
    .scr-toggle {
      position: relative;
      width: 50px; height: 30px;
      background: var(--paper-deep);
      border: 1.5px solid var(--border-strong);
      border-radius: 999px;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s ease;
      flex-shrink: 0;
    }
    .scr-toggle::after {
      content: '';
      position: absolute; top: 2px; left: 2px;
      width: 23px; height: 23px;
      border-radius: 999px;
      background: var(--paper-elevated);
      border: 1.5px solid var(--border-strong);
      box-shadow: 0 1px 0 var(--ink);
      transition: left 0.2s ease;
    }
    .scr-toggle.is-on { background: var(--lime); }
    .scr-toggle.is-on::after { left: 24px; }

    /* Chip */
    .scr-chip {
      display: inline-flex; align-items: center;
      padding: 6px 14px;
      border-radius: 999px;
      background: var(--paper-elevated);
      border: 1.5px solid var(--border-strong);
      font-family: var(--font-body); font-weight: 600;
      font-size: 13px; letter-spacing: -0.13px;
      color: var(--text-primary);
      box-shadow: var(--shadow-ink-sm);
      cursor: pointer;
      box-sizing: border-box;
    }
    .scr-chip.is-selected { background: var(--lime); }

    /* Status pill */
    .scr-pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid var(--border-strong);
      font-family: var(--font-mono); font-weight: 600;
      font-size: 10px; letter-spacing: 1.6px;
      text-transform: uppercase;
    }
    .scr-pill--confirmed { background: var(--lime); color: var(--text-primary); }
    .scr-pill--pending   { background: var(--butter); color: var(--text-primary); }
    .scr-pill--live      { background: var(--sky); color: var(--text-primary); }
    .scr-pill--failed    { background: var(--coral); color: var(--text-inverse); }
    .scr-pill-dot { width: 5px; height: 5px; border-radius: 999px; background: var(--ink); opacity: 0.6; }

    /* Bottom nav */
    .scr-bottom-nav {
      position: absolute; bottom: 0; left: 0; right: 0;
      height: 84px;
      background: var(--ink);
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 24px 24px;
    }
    .scr-nav-item {
      display: flex; align-items: center; justify-content: center;
      padding: 10px 20px;
      border-radius: 12px;
      background: transparent;
      border: none;
      cursor: pointer;
      font-family: var(--font-mono); font-weight: 500;
      font-size: 10px; letter-spacing: 1.6px;
      text-transform: uppercase;
      color: var(--text-inverse);
      opacity: 0.6;
      transition: opacity 0.15s ease;
    }
    .scr-nav-item.is-active {
      background: var(--lime);
      color: var(--text-primary);
      opacity: 1;
    }

    /* Activity row */
    .scr-activity-row {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 16px;
      border-radius: 14px;
      background: var(--paper-elevated);
      border: 1px solid var(--line);
      width: 100%;
      box-sizing: border-box;
    }
    .scr-activity-row--pending {
      background: var(--butter);
      border: 1.5px solid var(--border-strong);
    }

---
import Base from '@/layouts/Base.astro';

const title = 'Press — Sorted';
const description = 'Press contact, boilerplate and quick facts for anyone writing about Sorted.';
---

<Base title={title} description={description}>
<section class="subhero dotgrid">
  <div class="container">
    <div class="crumbs"><a href="/">Sorted</a><span class="sep"></span><span>Company</span><span class="sep"></span><span>Press</span></div>
    <span class="subhero-eyebrow">Company · Press</span>
    <h1><span class="hl">Press</span> &amp; media.</h1>
    <p class="subhero-sub">For interviews, brand assets and press enquiries, email <a class="inline-link" href="mailto:hello@paymentsorted.com?subject=Press%20enquiry">hello@paymentsorted.com</a> with "Press" in the subject. We reply within a business day.</p>
  </div>
</section>
<section class="section reveal"><div class="container">
    <div class="prose">
      <h2>About Sorted.</h2>
      <p>Sorted is an Australian peer-to-peer payments app. Top up free via PayID, send to any @handle in seconds, and tap to pay everywhere else with the Sorted card. Balances are held as AUDD, an Australian-dollar stablecoin issued by AUDC Pty Ltd, and settled on Solana. Users never see the blockchain.</p>
      <p>Built in Brisbane by a small team. Sorted operates as an authorised representative under an Australian Financial Services Licence and is in closed beta.</p>
      <h2>Quick facts.</h2>
      <ul>
        <li><strong>HQ:</strong> Brisbane, Queensland</li>
        <li><strong>Status:</strong> Closed beta. Public launch to be announced.</li>
        <li><strong>Regulation:</strong> Authorised representative under an AFSL. AML/CTF program to AUSTRAC standards.</li>
        <li><strong>Backing:</strong> 1:1 reserved AUDD issued by AUDC Pty Ltd, reserves at tier-1 Australian banks.</li>
        <li><strong>Settlement:</strong> Solana. Sub-second, sub-cent network cost, covered by Sorted.</li>
        <li><strong>Fees:</strong> None to send, receive, top up or hold.</li>
      </ul>
      <h2>Brand.</h2>
      <p>The wordmark is lowercase <em>sorted.</em> with the full stop. In body copy it's "Sorted" (never "SORTED"). Tagline: <em>"Money, sorted."</em> Logo files and brand colours are available on request.</p>
      <h2>Founders.</h2>
      <p>Available for interviews on Australian payments, stablecoins and building regulated products with a small team. Lead time is usually three to five business days.</p>
    </div></div></section>
<section class="page-cta">
  <div class="container">
    <div class="page-cta-inner reveal">
      <h2 class="page-cta-title">Working on a story?</h2>
      <p class="page-cta-sub">Send us the angle. A real person replies.</p>
      <div class="page-cta-actions">
        <a href="mailto:hello@paymentsorted.com?subject=Press%20enquiry" class="btn btn-dark btn-lg">Email us <svg class="icon"><use href="#i-arrow-up-right"/></svg></a>
        <a href="/how-it-works" class="btn btn-secondary btn-lg">How it works</a>
      </div>
    </div>
  </div>
</section>
</Base>

---
import { APP_URL, SOCIAL_X } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="logo" aria-label="Sorted home">
          <span class="logo-mark"><svg><use href="#sorted-mark"/></svg></span>
          sorted.
        </a>
        <p class="footer-tagline">Send money the second you mean to. Free. Tap to pay the rest.</p>
        <div class="footer-social">
          <a href={SOCIAL_X} target="_blank" rel="noopener" aria-label="Follow Sorted on X"><svg><use href="#i-twitter"/></svg></a>
        </div>
      </div>
      <div class="footer-col">
        <h4>The app</h4>
        <a href="/send">Send</a>
        <a href="/receive">Receive</a>
        <a href="/topup">Top up</a>
        <a href="/card">Card &amp; Perks</a>
        <a href={APP_URL}>Open the app</a>
      </div>
      <div class="footer-col">
        <h4>Sorted</h4>
        <a href="/how-it-works">How it works</a>
        <a href="/why-sorted">Why Sorted</a>
        <a href="/faq">FAQ</a>
        <a href="https://audd.digital" target="_blank" rel="noopener">About AUDD</a>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <a href="/contact">Contact</a>
        <a href="/press">Press</a>
        <a href="/careers">Careers</a>
        <a href={SOCIAL_X} target="_blank" rel="noopener">X / Twitter</a>
      </div>
      <div class="footer-col">
        <h4>Legal</h4>
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/compliance">Compliance</a>
        <a href="/security">Security</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Sorted Pty Ltd · Made in Brisbane, Queensland</span>
      <span class="powered-by">
        Powered by
        <img class="solana-logo" src="/solana-logo.svg" alt="Solana" width="120" height="18" />
      </span>
    </div>
  </div>
</footer>

---
interface Props {
  /** Body color of the mark */
  color?: string;
  /** Size in CSS units */
  size?: string;
  /** Extra rotation */
  rotate?: number;
  class?: string;
}
const {
  color = 'var(--lime)',
  size = '160px',
  rotate = 0,
  class: className = '',
} = Astro.props;

const styleStr = `width: ${size}; transform: rotate(${rotate}deg); --char-color: ${color};`;
---


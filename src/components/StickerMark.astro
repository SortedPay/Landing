      d="M502.05,921.27c-23.82,4.45-45.53,6.39-69.1,1.02-11.76-2.68-23.25-6.7-32.67-14.36-3.05-2.48-4.52-3.13-8.33-1.09-26.94,14.41-56.65,21.13-87.09,18.47-12.83-1.12-24.96-4.57-35.74-11.61l-9.48-7.89-10.9,10.19c-24.37,19.31-59.13,18.10-84.64,1.6-31.8-20.57-59.75-56.35-74.61-91.27-9.28-21.82-17.71-43.63-23.16-66.82l-9.06-38.55c-4.65-19.78-6.37-39.43-7.44-59.68-1.22-23.14,1.26-45.59,8.42-67.5,3.74-11.45,9.47-21.41,17.05-30.59,12.16-14.72,34.5-23.95,53.32-21.54,2.71.35,5.06-1.94,4.95-4.61-1.22-29.59,6.57-57.23,20.83-82.87,7.41-13.32,14.48-25.8,22.74-38.56l8.06-14.08c4.85-8.47,10.04-16.68,13-26.04,4.64-14.65,4.10-29.57,1.81-44.78-1.86-12.32-6.93-23.08-10.51-35.17-7.55-25.55-10.80-51.57-11.61-78.08-.22-7.28.76-14.03,1.78-21.25,2.13-15.13,8.34-29.90,18.13-41.45,6.77-7.99,14.88-12.87,24.16-16.83l10.78-2.72c13.72-3.46,27.36-2.50,41.32-.12,12.57,2.14,23.48,6.43,34.72,12.12,9.42,4.77,18.17,9.65,25.21,17.71l12.71,14.57c11.62,15.79,19.83,32.75,25.75,51.46,2.83,8.94,5.49,17.18,7.07,26.44,4.81,28.18,5.00,56.08,1.17,84.37l-3.28,24.17c-2.59,17.04-4.37,33.52-5.04,50.84l1.85,3.59c.5.98,3.45.71,4.63.48l22.86-4.58,25.92-2.84c35.09-3.84,80.50-.78,111.87,14.84,10.96,5.46,20.7,11.55,30.19,19.17,25.48,20.46,39.18,50.49,40.40,83.02,1.11,29.52-4.93,58.76-22.22,83.01l-4.97,6.98,13.08,17.69c25.11,33.95,25.10,83.38-2.13,116.11-1.66,2-5.13,3.84-5.69,6.54-1.38,6.66,15.07,14.61,20.80,45.95,5.55,30.33-2.33,54.59-25.18,75.20-23.18,20.91-51.17,33.63-81.75,39.34Z"
    />
    <!-- Sparkle rays around the head -->
    <path fill="none" stroke="var(--ink)" stroke-width="14" stroke-linecap="round" d="M286 80 L276 32"/>
    <path fill="none" stroke="var(--ink)" stroke-width="14" stroke-linecap="round" d="M120 200 L60 192"/>
    <path fill="none" stroke="var(--ink)" stroke-width="14" stroke-linecap="round" d="M180 110 L100 30"/>
    <path fill="none" stroke="var(--ink)" stroke-width="14" stroke-linecap="round" d="M380 130 L470 65"/>
    <path fill="none" stroke="var(--ink)" stroke-width="14" stroke-linecap="round" d="M50 320 L142 290"/>
  </svg>
</div>

<style>
  .sticker-mark {
    display: inline-block;
    aspect-ratio: 633.6 / 948.7;
    pointer-events: none;
  }
  .sticker-mark svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 6px 0 rgba(14, 14, 24, 0.18));
  }
</style>

# Neon Postgres connection string (set automatically by the Vercel Neon integration)
DATABASE_URL=

# Any random string. Visit /api/claim?init=<INIT_SECRET> once after deploy to create tables.
INIT_SECRET=

# Password for /admin (HTTP Basic Auth, username ignored). Admin is closed when unset.
ADMIN_PASSWORD=

# Optional: override where the claim modal posts. Defaults to same-origin /api/claim.
PUBLIC_CLAIM_ENDPOINT=
